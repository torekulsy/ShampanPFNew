    <link href="~/assets/css/menu.css" rel="stylesheet" />
    <link href="~/assets/css/toastr.css" rel="stylesheet" />

    <script>

        


        $(function () {

            InitDateTimePickers();
            toastr.options.positionClass = 'toast-top-center';
            var result = '@Session["rollPermission"]';
                       if (result != null) {
                           if (result.toLowerCase() == "deny") {
                               toastr.error('You Do not have permission to access this module', 'Permission deny')
                           }
                @{ Session["rollPermission"] = null; }
            }

            var permission = '@Session["permission"]';
            if (permission == "False") {
                toastr.error('You Do not have permission to access', 'Permission deny')
                @{ Session["permission"] = null; };
            }

            var result = '@Session["result"]';
            debugger;
            result = result.split("~");
            if (result[0] == "Success") {
                toastr.success(result[1], 'Shampan ERP')
                   @{ Session["result"] = null; }
            }
            else if (result[0] == "Fail") {
                toastr.error(result[1], 'Shampan ERP')
                @{ Session["result"] = null; };
            }
            else if (result[0] == "Info") {
                toastr.info(result[1], 'Shampan ERP')
                @{ Session["result"] = null; };
            }
            else if (result[0] == "Warning") {
                toastr.warning(result[1], 'Shampan ERP')
                @{ Session["result"] = null; };
            }
        })
        function InitDateTimePickers() {
            $(".customDatePicker").datepicker({
                changeYear: true, changeMonth: true, dateFormat: 'dd-M-yy', yearRange: '-90:+9', maxYear: '100'
            });
            $('.customTimePicker').prop("readonly", "readonly");
            $('.customDatePicker').prop("readonly", "readonly");
        }


        
    </script>
    <link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    @RenderSection("head", required: false)
    <style>


        .content.title {
            border-radius: 4px;
            padding: 15px 20px !important;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            width: 100%;
            background: rgba(255,255,255,.65) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(227,234,246,.6);
            position: relative;
            z-index: 10;
        }

            .content.title img {
                max-height: 60px;
            }

        .company-title {
            font-size: 28px;
            font-weight: 700;
            color: #1f6fdc;
        }

        .company-sub {
            font-size: 15px;
            color: #6b7280;
        }

        .main-wrapper {
            min-height: calc(100vh - 150px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .content-area {
            display: flex;
            gap: 25px;
        }


        .left-panel {
            flex: 2;
        }


        .right-panel {
            flex: 1;
        }


        .form-control {
            height: 45px;
            border-radius: 10px;
            border: 1px solid #dbe2ea;
            margin-bottom: 15px;
        }


        .footer {
            text-align: center;
            margin-top: 15px;
            color: #888;
        }

        .loginTopHeader {
            max-width: 1600px;
            margin: auto
        }

        .content.black p {
            color: #999;
            font-size: 1.3em;
            font-family: "Segoe UI", Verdana, Helvetica, sans-serif;
        }

        .content.black {
            background: #ffffff;
        }

        .bottom-footer {
            background: rgba(255,255,255,.65) !important;
            border-top: 1px solid rgba(227,234,246,.6);
            padding: 12px 20px;
            font-size: 14px;
            color: #5c6b7a;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .footer-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        /* Left side */
        .footer-left {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: "Segoe UI", Verdana, Helvetica, sans-serif;
        }

            .footer-left i {
                color: #4c84ff;
            }

            .footer-left a {
                color: #2d6cdf;
                text-decoration: none;
                font-weight: 500;
                font-family: "Segoe UI", Verdana, Helvetica, sans-serif;
            }

                .footer-left a:hover {
                    text-decoration: underline;
                }

        /* Right side */
        .footer-right {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #7b8a9a;
        }

            .footer-right i {
                color: #4c84ff;
            }
    </style>

</head>

@using System.Linq
@using SymServices.Common
@{
    DynamicNavbarViewModel model = new DynamicMenuService().BuildNavbarViewModel("WPPF");
}
<link href="~/assets/css/master.css" rel="stylesheet" />
<div id="leftside">
    <div id="scroll-side-menu" class="side-menu">
        <div id="sm-btn"><span class="btn btn-successful">Menu</span> </div>
        <ul id="s-sm" class="left_menu navbar-left">
            <a class="navbar-brand" href="@(model.HomeUrl)">
                <img src="~/Images/images/image/Logo.jpg" alt="" class="img-responsive navbar-brand_img" id="logo" />
            </a>
            <li>
                <span class="nav-icon-dashboard"></span>
                <span class="tri pos">
                    <i class="fa fa-align-justify" style="color: #fff"></i>
                    <img src="~/Images/images/dropdown3.png" alt="" />
                </span>
                <a tabindex="-1" class="btn btn-info" href="@(model.HomeUrl)">Dashboard</a>
            </li>
            @foreach (DynamicMenuModule module in model.Modules.Where(m => m != null && m.IsVisible))
            {
                <li class="dropdown-submenu @(module.IsCurrent ? "active" : string.Empty)">
                    <span class="nav-icon-hr"></span>
                    <a tabindex="-1" class="btn btn-info" href="@module.Url">@module.Title</a>
                </li>
            }
            <li>
                <span class="nav-icon-logout"></span>
                <span class="tri pos">
                    <i class="fa fa-align-justify" style="color: #fff"></i>
                    <img src="~/Images/images/dropdown3.png" alt="" />
                </span>
                <a tabindex="-1" class="btn btn-info" href="/Home/LogOut">Log Out</a>
            </li>
        </ul>
    </div>
</div>
<script>
    $(function () {
        $(window).scroll(function () {
            if ($(this).scrollTop() > 0) {
                $("#a").slideUp(600);
                $("#scroll-side-menu").css("cssText", "left: -200px;");
                $("#logo-two").addClass("log-act");
            }
            else {
                $("#scroll-side-menu").css("cssText", "left: -200px;");
                $("#a").slideDown(600);
                $("#logo-two").removeClass("log-act");
            }
        });
        $("#leftside").hover(function () {
            $("#scroll-side-menu").toggleClass("open");
            $("#scroll-side-menu .dropdown-submenu .tri").toggleClass("pos");
        });
    });
</script>

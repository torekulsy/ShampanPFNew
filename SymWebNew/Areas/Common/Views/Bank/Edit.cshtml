@model SymViewModel.Common.BankVM
@{
    Layout = null;
 }
@using (Html.BeginForm("Edit", "Bank", FormMethod.Post, new { @Id = "frmBank" }))
{
    @Html.ValidationSummary(true)
    <div class="">
        <div class="bank">
          <div class="row">
            <label class="col-sm-4">
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.BranchId)
                @Html.LabelFor(model => model.Code)
            </label>
            <div class="col-sm-8">
                @Html.TextBoxFor(model => model.Code, null, new { @placeholder = "Bank Code", @class = " required form-control" })
                @Html.ValidationMessageFor(model => model.Code)
            </div>
        </div>
            <div class="row mt-2">
                <label class="col-sm-4 ">
                    @Html.LabelFor(model => model.Name)
                </label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.Name, null, new { @placeholder = "Bank Name", @class = "required form-control " })
                    @Html.ValidationMessageFor(model => model.Name)
                </div>
            </div>
            <div class="row mt-2">
                <label class="col-sm-4">
                    @Html.LabelFor(model => model.IsActive)
                </label>
                <div class="col-sm-1">
                    @Html.CheckBoxFor(model => model.IsActive, new { @class = " form-control" })
                </div>
            </div>
            <div class="row mt-2">
                <label class="col-sm-4">
                    @Html.LabelFor(model => model.Remarks)
                </label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.Remarks, null, new { @placeholder = "Remarks", @class = " form-control" })
                    @Html.ValidationMessageFor(model => model.Remarks)
                </div>
            </div>
            
          <div class="row mt-3">
              <div class="col-sm-12">
                  <div class="reportModalbtn">
                      <button type="button" title="Edit Data" onclick="Edit();" class="Edit sym-btn-edit">&nbsp;Edit</button>
                      <button type="button" title="Save Data" onclick="pageSubmit('frmBank');" class="Save sym-btn-save">&nbsp;Save</button>

                      <button type="button" title="Cancel Data" class=" btncancel sym-btn-cancel">&nbsp;Cancel</button>
                  </div>
              </div>
        </div>

		

        @*<div class="row">
            <div class="col-sm-4">
                <input type="button" value="Edit" onclick="Edit();" class="Edit btn btn-primary" />
                <input type="button" onclick="pageSubmit('frmBank');" value="Save"  class=" Save btn btn-primary" />
            </div>
            <div class="col-sm-4">
                <input type="button" value="Cancel" class="btncancel btn btn-primary" />
            </div>
        </div>*@
        </div>
    </div>
}
<script>
  

    $(function () {
        Edit();
        valiDation("frmBank");
    });
    function Edit() {
        fnReadOnly("bank");
        if ($(".bank").hasClass("readOnly")) {
            $(".Save").hide();
            $(".Edit").show();
        }
        else {
            $(".Save").show();
            $(".Edit").hide();
        }
    }
</script>
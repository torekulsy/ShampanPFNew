    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New Branch" data-url="/Common/Branch/Create" onclick="GoTo(this)" id="" class="sym-btn-add ">&nbsp;New</button>
            <button type="button" title="Delete Branch" data-url="/Common/Branch/BranchDelete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>
            @*<button type="button" title="Add New" data-url="/Common/Branch/Import" onclick="GoTo(this)" id="" class=" sym-btn-Excel-Export ">&nbsp;Export/Emport</button>*@
        </div>

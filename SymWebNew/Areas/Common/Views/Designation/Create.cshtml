<style>
    /* ===== FULL OVERRIDE TAB DESIGN ===== */
    .fade:not(.show) {
        opacity: 1;
    }
    .tabDesign {
        display: flex !important;
        border-bottom: none !important;
        background: #f1f3f6 !important;
        padding: 5px !important;
        margin: 0 !important;
    }

        /* Remove your inline green background */
        .tabDesign .tabDefault {
            flex: 1 !important;
            text-align: center !important;
            background: transparent !important;
            margin: 0 2px !important;
            padding: 0 !important;
        }

            /* Tab button */
            .tabDesign .tabDefault a {
                display: block !important;
                padding: 10px 5px !important;
                background: #fbfbfb !important;
                border-radius: 4px 4px 0 0 !important;
                text-decoration: none !important;
                border: 2px solid transparent !important;
                transition: all 0.3s ease !important;
            }

                /* Hover */
                .tabDesign .tabDefault a:hover {
                    background: #dfe3e8 !important;
                    color: #000 !important;
                }

            /* ACTIVE TAB (MAIN DESIGN) */
            .tabDesign .tabDefault.active a {
                background: #ffffff !important;
                color: #28a745 !important;
                border-top: 2px solid #28a745 !important;
                font-weight: 600 !important;
            }

    /* Remove bootstrap default border */
    .nav-tabs > li > a {
        border: none !important;
    }
    .form-check-input {
        position: inherit;
        margin: auto!important;
    }
    .editor-label label {
        white-space: pre-wrap;
       
    }
</style>


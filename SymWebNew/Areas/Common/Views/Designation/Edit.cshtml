@model SymViewModel.HRM.DesignationVM
@using UIHelper.MVC
@{
    ViewBag.Title = "Edit";
    ViewBag.Location = "Edit";
}
<style>
    .editor-label label {
        white-space: pre-wrap;
    }
</style>

@using (Html.BeginForm("Edit", "Designation", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmDesignation" }))
{
    @Html.ValidationSummary(true)
    <div class="thinbox">
        <div class="th_thinbox">
            <p>Designation Edit</p>
        </div>
        <div class="Designation card-body">
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.BranchId)
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Code)
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.Code, new { @placeholder = "Code", @class = "required form-control" })
                        @Html.ValidationMessageFor(model => model.Code)
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Name)
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.Name, new { @placeholder = "Name", @class = "required form-control" })
                        @Html.ValidationMessageFor(model => model.Name)
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.DesignationGroupId)
                    </div>
                    <div class="editor-field">
                        @Html.SimpleDropDownFor(model => model.DesignationGroupId, "/Config/DropDown/DesignationGroupDropDown", new { @class = "cDesignationGroupId required form-control", data_disable_placeholder = "true" })
                        @Html.ValidationMessageFor(model => model.DesignationGroupId)
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.GradeId)
                    </div>
                    <div class="editor-field">
                        @Html.SimpleDropDownFor(model => model.GradeId, "/Config/DropDown/Grade", new { @class = "cGradeId required form-control", data_disable_placeholder = "true" })
                        @Html.ValidationMessageFor(model => model.GradeId)
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="headrow">
        <button type="button" title="Save Data" onclick="pageSubmit('frmDesignation');" class="sym-btn-update">&nbsp;Update</button>
    </div>
}

<script>
    $(function () {
        valiDation("frmDesignation");
    });
    $(function () {
        $("#frmDesignation").validate({
            ignore: [],
            errorClass: "text-danger",
            submitHandler: function (form) {
                form.submit();
            }
        });
    });
</script>

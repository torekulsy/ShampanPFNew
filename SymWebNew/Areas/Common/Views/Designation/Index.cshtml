            <button type="button" title="Delete Designation" data-url="/Common/Designation/Delete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>
            <button type="button" title="" data-url="/Common/Designation/Import" onclick="GoTo(this)" id="" class=" sym-btn-Excel-Export ">&nbsp;Export / Import</button>

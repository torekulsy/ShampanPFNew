<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        // Handle the "Select All" checkbox functionality
        $(document).on('click', '.chkAll', function () {
            var isChecked = $(this).is(':checked');
            $('#myDataTable tbody input[type="checkbox"]').prop('checked', isChecked);
        });

        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/Common/Designation/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },
            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                {
                    "sName": "Id",
                    "bSearchable": false,
                    "bSortable": false,
                    "sWidth": "10%",
                    "sClass": "center",
                    "fnRender": function (oObj) {
                        return '<input type="checkbox" data-Id="' + oObj.aData[0] + '">&nbsp; <a id="" title="Click on for Edit" style="text-decoration:none;" href="/Common/Designation/Edit/' + oObj.aData[0] + '" class="sym-btn-edit-row"></a>' +
                        '&nbsp; <a title="Click on for Delete" style="text-decoration:none;" data-url="/Common/Designation/Delete" onclick="deletedData(this, myDataTable,\'' + oObj.aData[0] + '\');" class="sym-btn-remove-row"></a>';
                    }
                },
                { "sName": "Code", "sWidth": "30%" },
                { "sName": "Name", "sWidth": "40%" },
                { "sName": "Active", "sWidth": "20%" }
            ]
        });
        oTable.columnFilter({
            sPlaceHolder: "head:after",
            aoColumns: [
                { type: "checkbox", "sClass": "chkAll" },
                { type: "text" },
                { type: "text" },
                { type: "select", values: ["Active", "Inactive"] }
            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>

<style>
    .dataTables_wrapper {
        zoom: 0.9!important;
    }
</style>

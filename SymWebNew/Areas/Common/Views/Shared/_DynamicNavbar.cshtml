@using System
@using System.Linq
@model SymServices.Common.DynamicNavbarViewModel
@{
    string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    bool isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);

    Func<string, string, bool> shouldOpenAsDialogReport = (url, groupTitle) =>
    {
        return !string.IsNullOrWhiteSpace(url)
            && !string.IsNullOrWhiteSpace(groupTitle)
            && groupTitle.Equals("Reports", StringComparison.OrdinalIgnoreCase)
            && url.IndexOf("ReportVeiw", StringComparison.OrdinalIgnoreCase) >= 0;
    };

    Func<string, string, string, string> menuLinkClass = (url, baseClass, groupTitle) =>
    {
        var linkClass = baseClass;
        if (shouldOpenAsDialogReport(url, groupTitle))
        {
            linkClass += " linkReport";
        }

        return linkClass;
    };
}

<div class="content white menuheight">
    <nav class="navbar navbar-default" role="navigation">
        <div class="navbar-header">
            <ul class="nav col-xs-4 visible-xs">
                <li class="dropdown1" style="padding-top:4px">
                    <a href="#" class="btn btn-warning">@Model.CurrentAreaLabel</a>
                </li>
            </ul>
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
        </div>
        <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
            <ul class="nav navbar-nav">
                <li class="Transfer @(isHomePage ? "active" : string.Empty)"><a href="@Model.HomeUrl">Home</a></li>
                @if (Model.Modules != null && Model.Modules.Any())
                {
                    <li class="Home dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">Module<b class="caret"></b></a>
                        <ul class="dropdown-menu">
                            @foreach (var module in Model.Modules)
                            {
                                <li><a class="btn btn-info" href="@module.Url">@module.Title</a></li>
                            }
                        </ul>
                    </li>
                }
                @foreach (var node in Model.Nodes)
                {
                    if (!node.IsDropdown)
                    {
                        <li class="@node.CssClass @(node.IsCurrent ? "active" : string.Empty)"><a class="@menuLinkClass(node.Url, string.Empty, node.Title)" href="@node.Url">@node.Title</a></li>
                    }
                    else
                    {
                        var hasSubGroups = node.SubGroups != null && node.SubGroups.Any();
                        var hasColumnLayout = node.LayoutColumns > 1 && hasSubGroups;
                        var renderedColumnCount = hasColumnLayout
                            ? System.Math.Max(node.LayoutColumns, node.SubGroups.Count + (node.Items.Any() ? 1 : 0))
                            : 1;
                        var columnClassName = "columns-" + System.Math.Min(4, System.Math.Max(1, renderedColumnCount));
                        var columnWidthClass = renderedColumnCount >= 4
                            ? "col-sm-3"
                            : renderedColumnCount == 3
                                ? "col-sm-4"
                                : renderedColumnCount == 2
                                    ? "col-sm-6"
                                    : "col-sm-12";

                        <li class="dropdown @node.CssClass @(node.IsCurrent ? "active" : string.Empty)">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">@node.Title <b class="caret"></b></a>
                            <ul class="dropdown-menu multi-column @columnClassName">
                                <div class="row">
                                    @if (hasColumnLayout)
                                    {
                                        if (node.Items.Any())
                                        {
                                            <div class="@columnWidthClass sym-menu-column">
                                                <ul class="multi-column-dropdown">
                                                    @foreach (var item in node.Items)
                                                    {
                                                        <li class="@(item.IsCurrent ? "active" : string.Empty)"><a class="@menuLinkClass(item.Url, "btn btn-info", node.Title)" href="@item.Url">@item.Title</a></li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        foreach (var subGroup in node.SubGroups)
                                        {
                                            <div class="@columnWidthClass sym-menu-column">
                                                <ul class="multi-column-dropdown">
                                                    <li class="sym-menu-group-title">@subGroup.Title</li>
                                                    @foreach (var item in subGroup.Items)
                                                    {
                                                        <li class="@(item.IsCurrent ? "active" : string.Empty)"><a class="@menuLinkClass(item.Url, "btn btn-info", node.Title)" href="@item.Url">@item.Title</a></li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-sm-12">
                                            <ul class="multi-column-dropdown">
                                                @foreach (var item in node.Items)
                                                {
                                                    <li class="@(item.IsCurrent ? "active" : string.Empty)"><a class="@menuLinkClass(item.Url, "btn btn-info", node.Title)" href="@item.Url">@item.Title</a></li>
                                                }
                                                @foreach (var subGroup in node.SubGroups)
                                                {
                                                    <li class="dropdown dropdown-submenu @(subGroup.Items.Any(i => i.IsCurrent) ? "active" : string.Empty)">
                                                        <a href="#" class="dropdown-toggle btn btn-info" data-toggle="dropdown">@subGroup.Title</a>
                                                        <ul class="dropdown-menu">
                                                            @foreach (var item in subGroup.Items)
                                                            {
                                                                <li class="@(item.IsCurrent ? "active" : string.Empty)"><a class="@menuLinkClass(item.Url, "dropdown btn btn-info", node.Title)" href="@item.Url">@item.Title</a></li>
                                                            }
                                                        </ul>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </ul>
                        </li>
                    }
                }
            </ul>

            <ul class="nav navbar-nav navbar-right" style="border-left:5px solid #fff">
                <li class="dropdown1">
                    <a href="#" class="dropdown-toggle sym-btn-back" title="Go Back" onclick="goBack()" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">&nbsp;Back</a>
                </li>
                <li class="dropdown1">
                    <a href="#" class="dropdown-toggle btn btn-warning" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">@Model.CurrentAreaLabel</a>
                </li>
            </ul>
        </div>
    </nav>
</div>
<style>
    .navbar-default .navbar-nav > li.dropdown:hover > a,
    .navbar-default .navbar-nav > li.dropdown:hover > a:hover,
    .navbar-default .navbar-nav > li.dropdown:hover > a:focus {
        color: rgb(85, 85, 85);
    }

    .dropdown-menu {
        min-width: 200px;
    }

    .dropdown-menu.columns-2 {
        min-width: 400px;
    }

    .dropdown-menu.columns-3 {
        min-width: 600px;
    }

    .dropdown-menu.columns-4 {
        min-width: 800px;
    }

    .dropdown-menu li a {
        padding: 5px 15px;
        font-weight: 300;
    }

    .multi-column-dropdown {
        list-style: none;
        padding-left: 0;
    }

    .multi-column-dropdown li a {
        display: block;
        clear: both;
        line-height: 1.428571429;
        color: #333;
        white-space: normal;
    }

    .multi-column-dropdown li a:hover {
        text-decoration: none;
        color: #262626;
        background-color: #f5f5f5;
    }

    li.dropdown:hover > .dropdown-menu {
        display: block;
    }

    .dropdown-submenu {
        position: relative;
    }

    .dropdown-submenu > .dropdown-menu {
        top: 0;
        left: 100%;
        margin-top: -1px;
    }

    .navbar-nav > li.active > a,
    .dropdown-menu > li.active > a {
        font-weight: 600;
    }

    .sym-menu-column {
        margin-bottom: 10px;
    }

    .sym-menu-group-title {
        padding: 5px 15px;
        font-weight: 600;
        color: #2f4f2f;
    }

    @@media (max-width: 767px) {
        .dropdown-menu.multi-column {
            min-width: 240px !important;
            overflow-x: hidden;
        }
    }
</style>

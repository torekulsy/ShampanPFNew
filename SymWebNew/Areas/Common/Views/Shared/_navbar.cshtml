<style>
    .navbar-default .navbar-nav > li.dropdown:hover > a,
    .navbar-default .navbar-nav > li.dropdown:hover > a:hover,
    .navbar-default .navbar-nav > li.dropdown:hover > a:focus {
        /*background-color: rgb(231, 231, 231);*/
        color: rgb(85, 85, 85);
    }

    li.dropdown:hover > .dropdown-menu {
        display: block;
    }
</style>
<script>
    $(document).ready(function () {

        var currentPath = window.location.pathname
            .replace(/\/+$/, '')
            .toLowerCase();

        var bestMatch = null;
        var bestMatchLength = 0;

        $('.navbar-nav a').each(function () {

            var href = $(this).attr('href');
            if (!href || href === '#' || href.indexOf('javascript') === 0) return;

            var linkPath = href.split('?')[0]
                .replace(/\/+$/, '')
                .toLowerCase();

            // exact or child path match
            if (currentPath === linkPath || currentPath.startsWith(linkPath + '/')) {

                if (linkPath.length > bestMatchLength) {
                    bestMatch = this;
                    bestMatchLength = linkPath.length;
                }
            }
        });

        if (bestMatch) {

            // child active
            $(bestMatch).parent('li').addClass('active');

            // submenu parent active
            $(bestMatch).parents('li.dropdown-submenu').addClass('active');

            // MAIN parent active
            $(bestMatch).parents('li.dropdown').addClass('active');
        }

    });

    $(function () {

        // Open menu
        $('.navbar-toggle').on('click', function (e) {
            e.preventDefault();
            $('#bs-example-navbar-collapse-1').addClass('open');
            $('.menu-overlay').addClass('show');
        });

        // Close menu
        $('.menu-overlay, .menu-close').on('click', function () {
            $('#bs-example-navbar-collapse-1').removeClass('open');
            $('.menu-overlay').removeClass('show');
        });

    });
</script>
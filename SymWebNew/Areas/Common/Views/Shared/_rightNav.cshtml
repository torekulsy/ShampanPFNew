<div class="adminProfi">
    <div class="rnavmain">
        <div class="user-panel d-flex">
            <div class="image">
                @*<img src="~/Files/EmployeeInfo/@Session["PhotoName"].ToString()" id="" class="img-circle elevation-2" alt="User Image" />*@
                <img src="~/Files/EmployeeInfo/avatar.png" id="" class="img-circle elevation-2" alt="User Image" />
            </div>
        </div>
    </div>
    <div id="Rnav" class="rnav">


        <div class="userLogInfo">
            <div class="custom-label">

                @try
                {
                    if (identity.IsAdmin)
                    {
                        <label>@Session["FullName"].ToString() (Admin)</label>
                    }
                    else
                    {
                        <label>@Session["FullName"].ToString() (User)</label>
                    }
                }
                catch (Exception)
                {
                }



                @*<a href="#" class="d-block">
                        <b>User : </b> @User.Identity?.Name
                    </a>*@
            </div>
            <div class="custom-label">
                <p style="color: #007bff; display: block; margin-bottom: 5px">
                   Company Name :  <b>(@CompanyName)</b>
</p>
                <p style="color: darkcyan"><span>Branch Name: <strong>(@BranchName)</strong> </span></p>
            </div>





        </div>
        <div class="Rbox">
            <div class="LogoutButton" style=" margin-left:21px;">

                <a title="Log Out" href="/Home/LogOut" style="font-size: 16px">
                    <img src="~/assets/Images/exit.png" alt="Log Out" />
                    <span>
                        Logout
                    </span>
                </a>
            </div>
        </div>
    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", () => {
        const rnav = document.querySelector(".rnav");
    const rnavMain = document.querySelector(".rnavmain");


    rnavMain.addEventListener("click", (e) => {
        e.stopPropagation();
    rnav.classList.toggle("active");
    });


    rnav.addEventListener("click", (e) => {
        e.stopPropagation();
    });


    document.addEventListener("click", () => {
        rnav.classList.remove("active");
    });
    });


</script>



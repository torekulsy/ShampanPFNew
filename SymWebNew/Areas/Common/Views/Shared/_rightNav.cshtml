@using SymOrdinary
@using System.Threading;
@{
    ShampanIdentity identity = null;
    try
    {
        identity = (ShampanIdentity)Thread.CurrentPrincipal.Identity;
    }
    catch (Exception)
    {
        Response.Redirect("/Home/Index");
        return;
    }
}
@{
    string CompanyName = System.Configuration.ConfigurationManager.AppSettings["CompanyName"];
    string BranchName = Session["BranchName"] != null ? Session["BranchName"].ToString() : "No Branch Selected";
}


<style>
    .RboxScroll {
        position: fixed;
        top: -125px;
    }

    .intop {
        top: 0px;
        transition: 0.5s;
    }

    .user-panel {
        text-align: left;
    }

    .image {
        text-align: center;
        margin-bottom: 10px;
    }

    .rnav div {
        text-align: left;
    }

    .custom-label {
        padding-left: 20px;
        display: block;
        width: 100%;
    }

    .adminProfi {
        right: 14px;
        position: fixed;
        top: 13px;
        z-index: 9999;
        cursor: pointer;
        padding: 0 10px;
    }

    .rnav {
        position: absolute;
        top: calc(100% + 17px);
        min-width: 250px;
        min-height: 100px;
        background: #fff;
        box-shadow: rgba(17, 17, 26, 0.1) 0px 4px 16px, rgba(17, 17, 26, 0.1) 0px 8px 24px, rgba(17, 17, 26, 0.1) 0px 16px 56px;
        opacity: 0;
        transform: translateY(-10px);
        visibility: hidden;
        transition: 300ms;
        right: 0;
        padding: 10px;
        border-radius: 10px;
    }

    .userLogInfo {
        font-size: 13px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .rnav.active {
        opacity: 1;
        transform: translateY(0);
        visibility: visible;
    }

    .rnav::before {
        content: "";
        position: absolute;
        top: -10px;
        right: 14px;
        width: 20px;
        height: 20px;
        background: #fff;
        transform: rotate(45deg);
        z-index: -1;
    }

    .custom-label {
        display: block;
    }

    .user-panel img {
        height: auto;
        width: 30px;
    }

    .LogoutButton a {
        display: flex;
        gap: 10px;
        align-items: center;
    }
        .LogoutButton a:hover{
            color: red;
            font-weight: 500;
            background: transparent
        }
        
         .LogoutButton a img {
            width: 30px;
            height: 24px;
        }

        .LogoutButton a span {
            display: block;
            white-space: nowrap;
        }
</style>



        //Animation on hide
    document.addEventListener("DOMContentLoaded", function () {

        const treeMenus = document.querySelectorAll(".nav-sidebar .has-treeview");
        const links = document.querySelectorAll(".nav-sidebar a");

        // 🔹 Smooth Slide Function
        function slideUp(element, duration = 300) {

            const submenu = element.querySelector(":scope > .nav-treeview");
            if (!submenu) return;

            submenu.style.height = submenu.offsetHeight + "px";
            submenu.style.transition = `all ${duration}ms ease`;
            submenu.style.overflow = "hidden";

            requestAnimationFrame(() => {
                submenu.style.height = "0px";
            submenu.style.opacity = "0";
        });

            setTimeout(() => {
                element.classList.remove("menu-open");
            submenu.style.removeProperty("height");
            submenu.style.removeProperty("overflow");
            submenu.style.removeProperty("transition");
            submenu.style.removeProperty("opacity");
        }, duration);
    }

    function slideDown(element, duration = 300) {

        const submenu = element.querySelector(":scope > .nav-treeview");
        if (!submenu) return;

        element.classList.add("menu-open");

        submenu.style.height = "0px";
        submenu.style.opacity = "0";
        submenu.style.overflow = "hidden";
        submenu.style.transition = `all ${duration}ms ease`;

        requestAnimationFrame(() => {
            submenu.style.height = submenu.scrollHeight + "px";
        submenu.style.opacity = "1";
    });

        setTimeout(() => {
            submenu.style.removeProperty("height");
        submenu.style.removeProperty("overflow");
        submenu.style.removeProperty("transition");
        submenu.style.removeProperty("opacity");
    }, duration);
    }

    // 🔹 Restore Active Link
    const activeHref = localStorage.getItem("activeLink");

    if (activeHref) {

        links.forEach(link => {

            if (link.getAttribute("href") === activeHref) {

                link.classList.add("active");

        let parentTree = link.closest(".has-treeview");

        while (parentTree) {

            parentTree.classList.add("menu-open");

            const parentLink = parentTree.querySelector(":scope > a");

            if (parentLink) {
                parentLink.classList.add("active");
            }

            parentTree = parentTree.parentElement.closest(".has-treeview");
        }
    }
    });
    }

    // 🔹 Click Event
    links.forEach(link => {

        link.addEventListener("click", function () {

            const href = link.getAttribute("href");

            if (!href || href === "#") return;

            // Save Active Link
            localStorage.setItem("activeLink", href);

            // Remove all active classes
            links.forEach(l => l.classList.remove("active"));

            // Smooth Close Other Menus
            treeMenus.forEach(menu => {

                if (!menu.contains(link) && menu.classList.contains("menu-open")) {
                    slideUp(menu);
        }
        });

    // Active Current Link
    link.classList.add("active");

    // Open Parent Menus Smoothly
    let parentTree = link.closest(".has-treeview");

    while (parentTree) {

        if (!parentTree.classList.contains("menu-open")) {
            slideDown(parentTree);
        }

        const parentLink = parentTree.querySelector(":scope > a");

        if (parentLink) {
            parentLink.classList.add("active");
        }

        parentTree = parentTree.parentElement.closest(".has-treeview");
    }
    });
    });

    });
       
    </script>

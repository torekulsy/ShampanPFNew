        if (t == "all employee") return new MenuIconInfo { IconClass = "fas fa-users", Color = "#38BDF8" };
        if (t == "employee statement") return new MenuIconInfo { IconClass = "fas fa-file-alt", Color = "#A78BFA" };
        if (t == "employee ledger") return new MenuIconInfo { IconClass = "fas fa-address-book", Color = "#60A5FA" };
        if (t == "loan statement") return new MenuIconInfo { IconClass = "fas fa-file-invoice", Color = "#FBBF24" };
        if (t == "schedule of loan member") return new MenuIconInfo { IconClass = "fas fa-table", Color = "#2DD4BF" };
        if (t == "loan early settelment" || t == "loan early settlement") return new MenuIconInfo { IconClass = "fas fa-history", Color = "#34D399" };
        if (t == "loan monthly payment") return new MenuIconInfo { IconClass = "fas fa-calendar-alt", Color = "#FB923C" };
        if (t == "loan repayment to bank") return new MenuIconInfo { IconClass = "fas fa-university", Color = "#FACC15" };

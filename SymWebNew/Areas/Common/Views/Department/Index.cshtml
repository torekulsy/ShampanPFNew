@model IEnumerable<SymViewModel.Common.DepartmentVM>
@{
    ViewBag.Title = "Index";
}
<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/Common/Department/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "5%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    return ' <input onclick="CheckAll(this)" type="checkbox" data-Id="' + oObj.aData[0] + '">&nbsp; <a title="Click on for Edit"  style="text-decoration:none;" id="lnkEdit1"class=" lnkEdit sym-btn-edit-row"  href=\"/Common/Department/Edit/' + oObj.aData[0] + '\"></a>' +
                                    '&nbsp; <a title="Click on for Delete" style="text-decoration:none;" data-url="/Common/Department/DepartmentDelete" onclick="deletedData(this, myDataTable,\'' + oObj.aData[0] + '\');"  class="sym-btn-remove-row"></a>';
                                }
                            }
                           
                            , { "sName": "Code", "sWidth": "20%" }
                            , { "sName": "Name", "sWidth": "25%" }
                            , { "sName": "Active", "sWidth": "15%" }
                            , { "sName": "Remarks", "sWidth": "25%" }
            ]
        });
        oTable.columnFilter({
            sPlaceHolder: "head:after",
            aoColumns: [{ type: "checkbox", "sClass": "chkAll" }
                       , { type: "text" }
                       , { type: "text" }
                       , { type: "select", values: ["Active", "Inactive"] }
                       , { type: "text" }
                       , { type: "text" }
            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>
<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Department List</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox">
    <div class="th_thinbox">
        <p>Department List</p>
    </div>


    <div class="custom-top">
        <div id="mainBtnAll">
            <button type="button" title="Add New Department" data-url="/Common/Department/Create" id="" class="btnCreate sym-btn-add ">&nbsp;New</button>
            <button type="button" title="Delete Department" data-url="/Common/Department/DepartmentDelete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>
            <button type="button" title="" data-url="/Common/Department/Import" onclick="GoTo(this)" id="" class=" sym-btn-Excel-Export ">&nbsp;Export / Import</button>
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>
    <table id="myDataTable" class="display">
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" class="chkAll" />Select All</th>
                <th>Code</th>
                <th>Name</th>
                <th>Active/Inactive</th>
                <th>Remarks</th>
            </tr>
            <tr>
                <th class="center">Actions</th>
                <th>Code</th>
                <th>Name</th>
                <th>Active/Inactive</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New Department" data-url="/Common/Department/Create" id="" class="btnCreate sym-btn-add ">&nbsp;New</button>
            <button type="button" title="Delete Department" data-url="/Common/Department/DepartmentDelete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>
        </div>
    </div>
</div>



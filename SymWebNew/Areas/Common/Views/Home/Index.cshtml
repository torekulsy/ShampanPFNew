<script>


    const months = [
    "Jan","Feb","Mar","Apr","May","Jun",
    "Jul","Aug","Sep","Oct","Nov","Dec"
    ];

    const deptData = [
        { month: 0, year: 2025, HR: 10, IT: 20, Accounts: 5, Sales: 15 },
        { month: 1, year: 2025, HR: 12, IT: 25, Accounts: 7, Sales: 18 },
        { month: 2, year: 2025, HR: 15, IT: 30, Accounts: 10, Sales: 20 },
        { month: 3, year: 2025, HR: 18, IT: 35, Accounts: 12, Sales: 22 },
        { month: 4, year: 2025, HR: 20, IT: 38, Accounts: 14, Sales: 25 },

        { month: 0, year: 2026, HR: 8, IT: 18, Accounts: 4, Sales: 12 },
        { month: 1, year: 2026, HR: 11, IT: 22, Accounts: 6, Sales: 16 },
        { month: 2, year: 2026, HR: 13, IT: 24, Accounts: 7, Sales: 18 }
    ];

    const monthFilterDep = document.getElementById("monthFilterDep");
    const yearFilterDep = document.getElementById("yearFilterDep");

    const currentDate = new Date();
    const currentYear = currentDate.getFullYear();
    const currentMonth = currentDate.getMonth();

    const deptChart = new Chart(document.getElementById("deptChart"), {
        type: "bar",
        data: {
            labels: [],
            datasets: [
                {
                    label: "HR",
                    data: [],
                    backgroundColor: "#4e73df"
                },
                {
                    label: "IT",
                    data: [],
                    backgroundColor: "#1cc88a"
                },
                {
                    label: "Accounts",
                    data: [],
                    backgroundColor: "#36b9cc"
                },
                {
                    label: "Sales",
                    data: [],
                    backgroundColor: "#f6c23e"
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    function getFilteredDeptData() {

        const year = parseInt(yearFilterDep.value);
        const month = monthFilterDep.value;

        let data = deptData.filter(x => x.year == year);

        if (month !== "") {
            data = data.filter(x => x.month == month);
        }
        else if (year === currentYear) {
            data = data.filter(x => x.month <= currentMonth);
        }

        return data;
    }

    function updateDeptChart() {

        const data = getFilteredDeptData();

        deptChart.data.labels = data.map(x => months[x.month]);

        deptChart.data.datasets[0].data = data.map(x => x.HR);
        deptChart.data.datasets[1].data = data.map(x => x.IT);
        deptChart.data.datasets[2].data = data.map(x => x.Accounts);
        deptChart.data.datasets[3].data = data.map(x => x.Sales);

        deptChart.update();
    }

    window.addEventListener("load", function () {

        yearFilterDep.value = currentYear;
        monthFilterDep.value = "";

        updateDeptChart();
    });

    monthFilterDep.addEventListener("change", updateDeptChart);
    yearFilterDep.addEventListener("change", updateDeptChart);


</script>

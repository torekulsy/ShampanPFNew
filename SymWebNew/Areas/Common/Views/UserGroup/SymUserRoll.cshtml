                    $(document).ready(function () {

                        var isSyncingTop = false;
                        var isSyncingBottom = false;

                        $('#scrollTop').on('scroll', function () {
                            if (!isSyncingTop) {
                                isSyncingBottom = true;
                                $('#scrollBottom').scrollLeft($(this).scrollLeft());
                            }
                            isSyncingTop = false;
                        });

                        $('#scrollBottom').on('scroll', function () {
                            if (!isSyncingBottom) {

@{
    ViewBag.Title = "Company List";
}

<style>
    .sym-btn-add:before {
        margin-right: 5px;
    }

    .dataTable tbody td:nth-child(2) {
        padding-right: 20px;
    }
</style>

<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Company List</p>

            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox">

    <div class="th_thinbox">
        <p>Company List</p>
    </div>

    <div class="custom-top">

        <div id="mainBtnAll">
            @Html.ActionLink(
                " New",
                "Create",
                null,
                new
                {
                    title = "Add New Company",
                    @class = "sym-btn-add"
                })
        </div>

        <div class="table-search">

            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>

            <div id="dataTables_filter"></div>

        </div>

    </div>

    <table id="myDataTable" class="display">

        <thead>

         
            <tr>
                <th class="center "></th>
                <th class="left">Code</th>
                <th class="left">Name</th>
                <th class="left">Address</th>
                <th class="left">Phone</th>
                <th class="left">Remarks</th>
                <th class="left">Is Active</th>
            </tr>

         
            <tr>
                <th class="center">Action</th>
                <th class="left">Code</th>
                <th class="left">Name</th>
                <th class="left">Address</th>
                <th class="left">Phone</th>
                <th class="left">Remarks</th>
                <th class="left">Is Active</th>
            </tr>

        </thead>

        <tbody></tbody>

    </table>

    <div class="custom-footer">

        <div id="footer-length"></div>

        <div id="footer-info"></div>

        <div id="footer-pagination"></div>

    </div>

</div>

<script language="javascript" type="text/javascript">

    $(document).ready(function () {

        $.datepicker.regional[""].dateFormat = "dd/M/y";
        $.datepicker.setDefaults($.datepicker.regional[""]);

        var oTable = $("#myDataTable").dataTable({

            "bServerSide": true,
            "bProcessing": true,
            "bPaginate": true,
            "bAutoWidth": false,

            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "aLengthMenu": tablelength(),

            "sAjaxSource": "/Common/Company/_index",

            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {

                $(".dataTables_filter input")
                    .attr("placeholder", "Search...");

            },

            "aoColumns": [

                {
                    "sName": "Id",
                    "bSearchable": false,
                    "bSortable": false,
                    "sWidth": "5%",
                    "sClass": "center",

                    "fnRender": function (oObj) {

                        var companyId = oObj.aData[0];

                        return ''
                            + '<a '
                            + 'title="Click for Edit" '
                            + 'style="text-decoration:none;" '
                            + 'href="/Common/Company/Edit/' + companyId + '" '
                            + 'class="sym-btn-edit-row">'
                            + '</a>'

                            + '&nbsp;'

                            + '<a '
                            + 'title="Click for Delete" '
                            + 'style="text-decoration:none;" '
                            + 'href="javascript:void(0);" '
                            + 'data-url="/Common/Company/Delete" '
                            + 'onclick="deletedData('
                            + 'this, '
                            + '\'myDataTable\', '
                            + '\'' + companyId + '\''
                            + ');" '
                            + 'class="sym-btn-remove-row">'
                            + '</a>';
                    }
                },

                {
                    "sName": "Code",
                    "sWidth": "7%"
                },

                {
                    "sName": "Name",
                    "sWidth": "10%"
                },

                {
                    "sName": "Address",
                    "sWidth": "30%"
                },

                {
                    "sName": "Phone",
                    "sWidth": "10%"
                },

                {
                    "sName": "Remarks",
                    "sWidth": "10%"
                },

                {
                    "sName": "IsActive",
                    "sWidth": "10%"
                }
            ]
        });


        oTable.columnFilter({

            sPlaceHolder: "head:after",

            aoColumns: [

                null,

                {
                    type: "text"
                },

                {
                    type: "text"
                },

                {
                    type: "text"
                },

                {
                    type: "text"
                },

                {
                    type: "text"
                },

                {
                    type: "select",
                    values: [
                        "Yes",
                        "No"
                    ]
                }
            ]
        });

        $("#footer-length").append(
            $(".dataTables_length")
        );

        $("#footer-info").append(
            $(".dataTables_info")
        );

        $("#footer-pagination").append(
            $(".dataTables_paginate")
        );

        $("#dataTables_filter").append(
            $(".dataTables_filter")
        );

        $(document).on(
            "click",
            ".mobile-search-toggle",
            function (e) {

                e.stopPropagation();

                $("#dataTables_filter").slideToggle(150);
            }
        );

    });

</script>
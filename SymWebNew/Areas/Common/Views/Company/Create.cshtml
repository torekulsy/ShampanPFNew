        //            $('#LogoImage').attr('src', e.target.result);
        //        }
        //        reader.readAsDataURL(input.files[0]);
        //    }
        //}



        function ShowpImagePreview(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#LogoImage').attr('src', e.target.result).show();
                    $('.upload-content').hide();
                };

                reader.readAsDataURL(input.files[0]);

                // File name show
                var fileName = input.files[0].name;
                $('#fileName').text(fileName);
                $('.file-info').attr('data-fullname', fileName);
            }
        }


        function removeFile() {

            // Clear file input
            const fileInput = document.getElementById("FileUpload");
            fileInput.value = "";

            // Reset image preview (default image set)
            const img = document.getElementById("LogoImage");
            img.src = "/Images/default-logo.png";

            // Show upload content again
            document.querySelector(".upload-content").style.display = "block";

            // Reset file name text
            document.getElementById("fileName").innerText = "No selected File";

            // Reset tooltip
            document.querySelector(".file-info").setAttribute("data-fullname", "No selected File");
        }






    </script>

@model SymViewModel.Common.CompanyVM

@{
    ViewBag.Title = "Edit";
}

<style>
    div > input[type="checkbox"] {
        text-align: center;
        margin: 0 !important;
    }

    .employee-image-card {
       margin-top: 20px;
        background: #f3f6fb;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        max-width: 150px;
        margin-left: auto;
        margin-right: auto;
    }
    /* Upload Area */

    .image-wrapper {
        position: relative;
        border: 2px dashed #2e6fd8;
        border-radius: 10px;
        text-align: center;
        background: #e9edf5;
        cursor: pointer;
        transition: 0.3s ease;
        min-height: 100px;
    }

        .image-wrapper:hover {
            background: #dde5f2;
        }

    .upload-content {
        pointer-events: none;
    }

    .upload-icon {
        font-size: 45px;
        color: #2e6fd8;
        display: block;
        margin-bottom: 10px;
    }

    .upload-content p {
        margin: 0;
        font-size: 16px;
        color: #333;
    }
    /* Image Preview */

    .image-wrapper img {
        width: 100%;
        object-fit: cover;
        border-radius: 8px;
        
    }
    /* Hide input */

    .image-wrapper input[type="file"] {
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        top: 0;
        opacity: 0;
        cursor: pointer;
    }
    /* File Info Section */

    .file-info {
        position: relative;
        margin-top: 15px;
        padding: 5px 10px;
        background: #dce3ef;
        border-radius: 8px;
        display: flex;
        align-items: center;
        overflow: visible; /* must be visible for tooltip */
    }

    .file-name {
        flex: 1;
        white-space: nowrap;
        overflow: hidden; /* ellipsis */
        text-overflow: ellipsis;
        cursor: pointer;
        position: relative;
    }
    /* Tooltip (shown on hover) */

    .file-info:hover::after {
        content: attr(data-fullname);
        position: absolute;
        top: -35px; /* adjust above text */
        left: 0;
        background: #222;
        color: #fff;
        padding: 6px 10px;
        font-size: 13px;
        border-radius: 6px;
        white-space: nowrap;
        max-width: 300px;
        z-index: 999;
        opacity: 1;
    }

    .file-info:hover::before {
        content: "";
        position: absolute;
        top: -12px; /* arrow */
        left: 15px;
        border-width: 6px;
        border-style: solid;
        border-color: #222 transparent transparent transparent;
        z-index: 999;
        opacity: 1;
    }


</style>


@section Scripts {
    <script>
        $(function () {
            Country();
            Division();
            District();
            if ($("#YearStart").val()!="") {
                $("#YearStart").attr('disabled', true);
            }
        })
        function FiscalYear() {
            var startDate = new Date(ParseDate($("#YearStart").val()));
            var day = 01;
            var mon = startDate.getMonth();
            var yr = startDate.getFullYear();
            var stDate = FormatDate(new Date(yr, mon, day));
            $("#YearStart").val(stDate);
            $("#Year").val(yr);
        }

        //function ShowpImagePreview(input) {
        //    if (input.files && input.files[0]) {
        //        var reader = new FileReader();
        //        reader.onload = function (e) {
        //            $('#LogoImage').attr('src', e.target.result);
        //        }
        //        reader.readAsDataURL(input.files[0]);
        //    }
        //}

        function ShowpImagePreview(input) {
            if (input.files && input.files[0]) {

                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#LogoImage').attr('src', e.target.result);

                    // Hide upload text
                    $('.upload-content').hide();
                }

                reader.readAsDataURL(input.files[0]);

                // Show file name
                var fileName = input.files[0].name;
                $('#fileName').text(fileName);
                $('.file-info').attr('data-fullname', fileName);
            }
        }

        function removeFile() {

            $('#FileUpload').val("");

            // Reset image
            var defaultImage = '@Url.Content("~/Images/default-logo.png")';
            $('#LogoImage').attr('src', defaultImage);

            // Show upload text again
            $('.upload-content').show();

            // Reset filename
            $('#fileName').text("No selected File");
            $('.file-info').attr('data-fullname', "No selected File");
        }

    </script>
}

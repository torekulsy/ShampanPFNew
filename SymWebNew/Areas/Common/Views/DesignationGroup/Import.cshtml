@{
    ViewBag.Title = "Import";
}
<style>
    .importnandexport {
        display: flex;
        justify-content: center;
        align-items: center;
        column-gap: 10px;
    }
</style>

        <div class="th_thinbox_top" style="display: flex; justify-content: flex-end">
            
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
 


<div class="thinbox mt-2">
    <div class="th_thinbox">
        <p>Designation Group Import / Export</p>
    </div>
    <div class="card-body">
        @using (Ajax.BeginForm("UploadExcel", "DesignationGroup", null, new AjaxOptions { }, new { enctype = "multipart/form-data", id = "frmUploadExcel" }))
        {
            <div class="importnandexport">
                <div >
                    <label>&nbsp;</label>
                    <button type="button" title="Export Data" onclick="ExportExcell()" class="sym-btn-Excel-Export">&nbsp;Export</button>
                </div>

                <div >
                    <label>File</label>
                    <input type="File" accept=".xlsx" name="file" id="FileUpload" style="width: 100%"  class="required " />
                </div>
                <div >
                    <label>&nbsp;</label>
                    <button type="button" onclick="pageSubmit('frmUploadExcel');" title="Upload Data" class="sym-btn-file-upload" value="Upload">&nbsp;Upload</button>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function ExportExcell() {
        var questionMSG = "Are you sure you want to export data?";
        Ask(questionMSG, function () {
            window.location.href = '/DesignationGroup/ExportExcell'; // Ensure correct controller name
        });
    }
</script>

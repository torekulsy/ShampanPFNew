    <script language="javascript" type="text/javascript">
        $(document).ready(function () {
            SelectAllForDelete();
            $.datepicker.regional[""].dateFormat = 'dd/M/y';
            $.datepicker.setDefaults($.datepicker.regional['']);
            var oTable = $('#myDataTable').dataTable({
                "bServerSide": true,
                "sAjaxSource": "/Common/Project/_index",
                "bProcessing": true,
                "aLengthMenu": tablelength(),
                "bJqueryUI": true,
                "bAutoWidth": false,
                "bPaginate": true,
                "sPaginationType": "full_numbers",
                "iDisplayLength": 10,
                "oLanguage": {
                    "oPaginate": {
                        "sPrevious": '<i class="fa fa-angle-left"></i>',
                        "sNext": '<i class="fa fa-angle-right"></i>'
                    },
                    "sSearch": ""
                },

                "fnDrawCallback": function () {
                    $('.dataTables_filter input')
                        .attr('placeholder', 'Search...');
                },
                "aoColumns": [
                                {
                                    "sName": "Id",
                                    "bSearchable": false,
                                    "bSortable": false,
                                    "sWidth": "5%",
                                    "sClass": "center",
                                    "fnRender": function (oObj) {
                                        return ' <input onclick="CheckAll(this)" type="checkbox" data-Id="' + oObj.aData[0] + '">&nbsp; <a title="Click on for Edit" style="text-decoration:none;" id=""   class=" innerListLink  sym-btn-edit-row"   href=\"/Common/Project/Edit/' + oObj.aData[0] + '\"></a>' +
                                        '&nbsp; <a title="Click on for Delete" style="text-decoration:none;" data-url="/Common/Project/ProjectDelete" onclick="deletedData(this, myDataTable,\'' + oObj.aData[0] + '\');"  class="sym-btn-remove-row"></a>';
                                }
            }
                                , { "sName": "Code", "sWidth": "10%" }
                                , { "sName": "Name", "sWidth": "20%" }
                                , { "sName": "ContactPersonName", "sWidth": "18%" }
                                , { "sName": "Mobile", "sWidth": "10%" }
                                , { "sName": "Manpower", "sWidth": "10%", "sClass": "center" }
                                , { "sName": "StartDate", "sWidth": "20%", "sClass": "center" }
                ]
            });
            oTable.columnFilter({
                sPlaceHolder: "head:after",
                aoColumns: [{ type: "checkbox", "sClass": "chkAll" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "date-range" }
                ]
            });
            $("#footer-length").append($(".dataTables_length"));
            $("#footer-info").append($(".dataTables_info"));
            $("#footer-pagination").append($(".dataTables_paginate"));
            $("#dataTables_filter").append($(".dataTables_filter"));

            $(document).on("click", ".mobile-search-toggle", function (e) {
                e.stopPropagation();
                $("#dataTables_filter").slideToggle(150);
            });
        });
    </script>

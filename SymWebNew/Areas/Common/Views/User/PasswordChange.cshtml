@model SymViewModel.Common.UserLogsVM

@using SymOrdinary
@using System.Threading

@{
    ShampanIdentity identity = null;

    try
    {
        identity = (ShampanIdentity)Thread.CurrentPrincipal.Identity;
    }
    catch (Exception)
    {
        Response.Redirect("/Home/Index");
        return;
    }

    Layout = null;

    // Admin অথবা HRM অন্য user-এর password reset করতে পারবে
    bool canResetWithoutOldPassword =
        identity.IsAdmin || identity.IsHRM;
}

@using (Html.BeginForm(
    "PasswordChange",
    "User",
    FormMethod.Post,
    new { id = "frmUser", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.BranchId)
    @Html.HiddenFor(model => model.EmployeeId)
    @Html.HiddenFor(model => model.LogID)

    <div class="thinbox">
        <div class="User">

            <div class="row">
                <div class="col-sm-12 text-center">
                    <strong style="font-size:15px;">
                        @Html.ValueFor(model => model.FullName)
                        (@Html.ValueFor(model => model.LogID))
                    </strong>
                </div>
            </div>

            <div class="row mt-3" id="oldPasswordRow">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.OldPassword)
                </div>

                <div class="col-md-12">
                    @Html.PasswordFor(
                        model => model.OldPassword,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Current Password",
                            autocomplete = "current-password"
                        })

                    <span id="OldPasswordError"
                          class="text-danger password-validation-message">
                    </span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.Password, "New Password")
                </div>

                <div class="col-md-12">
                    @Html.PasswordFor(
                        model => model.Password,
                        new
                        {
                            @class = "form-control",
                            placeholder = "New Password",
                            autocomplete = "new-password"
                        })

                    <span id="PasswordError"
                          class="text-danger password-validation-message">
                    </span>

                    <small class="form-text text-muted">
                        Minimum 8 characters with uppercase, lowercase,
                        number and special character.
                    </small>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.confirmPassword)
                </div>

                <div class="col-md-12">
                    @Html.PasswordFor(
                        model => model.confirmPassword,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Confirm Password",
                            autocomplete = "new-password"
                        })

                    <span id="confirmPasswordError"
                          class="text-danger password-validation-message">
                    </span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="reportModalbtn">

                        <button type="button"
                                title="Edit Data"
                                onclick="Edit();"
                                class="Edit sym-btn-edit">
                            &nbsp;Edit
                        </button>

                        <button type="button"
                                title="Save Data"
                                onclick="submitPasswordChange();"
                                class="Save sym-btn-save">
                            &nbsp;Save
                        </button>

                        <button type="button"
                                title="Cancel Data"
                                class="btncancel sym-btn-cancel">
                            &nbsp;Cancel
                        </button>

                    </div>
                </div>
            </div>

        </div>
    </div>
}

<script>
    var canResetWithoutOldPassword =
        @Html.Raw(canResetWithoutOldPassword
            .ToString()
            .ToLowerInvariant());

    $(function () {

        Edit();

        /*
         * Admin/HRM অন্য user-এর password reset করার সময়
         * current password প্রয়োজন হবে না।
         */
        if (canResetWithoutOldPassword) {
            $("#oldPasswordRow").hide();
            $("#OldPassword").val("");
        } else {
            $("#oldPasswordRow").show();
        }

        $("#OldPassword, #Password, #confirmPassword")
            .on("input change", function () {
                clearPasswordFieldError(this.id);
            });
    });

    function submitPasswordChange() {

        clearAllPasswordErrors();

        var isValid = true;

        var oldPassword =
            $.trim($("#OldPassword").val() || "");

        var newPassword =
            $("#Password").val() || "";

        var confirmPassword =
            $("#confirmPassword").val() || "";

        if (!canResetWithoutOldPassword &&
            oldPassword === "") {

            showPasswordFieldError(
                "OldPassword",
                "Current password is required."
            );

            isValid = false;
        }

        if (newPassword === "") {

            showPasswordFieldError(
                "Password",
                "New password is required."
            );

            isValid = false;
        }

        if (confirmPassword === "") {

            showPasswordFieldError(
                "confirmPassword",
                "Confirm password is required."
            );

            isValid = false;
        }

        if (newPassword !== "" &&
            confirmPassword !== "" &&
            newPassword !== confirmPassword) {

            showPasswordFieldError(
                "confirmPassword",
                "New password and confirm password do not match."
            );

            isValid = false;
        }

        /*
         * Password policy:
         * Minimum 8 characters
         * At least one uppercase letter
         * At least one lowercase letter
         * At least one number
         * At least one special character
         * No whitespace
         */
        var passwordPolicy =
            /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9])(?=\S+$).{8,}$/;

        if (newPassword !== "" &&
            !passwordPolicy.test(newPassword)) {

            showPasswordFieldError(
                "Password",
                "New password must be at least 8 characters and include uppercase, lowercase, number and special character without spaces."
            );

            isValid = false;
        }

        if (!canResetWithoutOldPassword &&
            oldPassword !== "" &&
            newPassword !== "" &&
            oldPassword === newPassword) {

            showPasswordFieldError(
                "Password",
                "New password cannot be the same as the current password."
            );

            isValid = false;
        }

        if (!isValid) {
            return;
        }

        $(".loading").show();

        document.getElementById("frmUser").submit();
    }

    function showPasswordFieldError(fieldId, message) {

        $("#" + fieldId)
            .addClass("input-validation-error");

        $("#" + fieldId + "Error")
            .text(message)
            .show();
    }

    function clearPasswordFieldError(fieldId) {

        $("#" + fieldId)
            .removeClass("input-validation-error");

        $("#" + fieldId + "Error")
            .text("")
            .hide();
    }

    function clearAllPasswordErrors() {

        clearPasswordFieldError("OldPassword");
        clearPasswordFieldError("Password");
        clearPasswordFieldError("confirmPassword");
    }

    function Edit() {

        fnReadOnly("User");

        if ($(".User").hasClass("readOnly")) {
            $(".Save").hide();
            $(".Edit").show();
        } else {
            $(".Save").show();
            $(".Edit").hide();
        }
    }
</script>
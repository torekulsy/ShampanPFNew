@{
    ViewBag.Title = "Index";
}
@using UIHelper.MVC

<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>User</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div id="Detaildiv"></div>
<div class="thinbox">
    <div class="th_thinbox">
        <p>User</p>
    </div>

    <div class="custom-top">
        <div id="mainBtnAll">

        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>

    <div id="container">
        <div id="demo">
            <table id="myDataTable" class="display">
                <thead>
                    <tr>
                        <th class="center"> Select All</th>
                        <th>Group Name</th>
                        <th>Super</th>
                    </tr>
                    <tr>
                        <th class="center">Actions</th>
                        <th>Group Name</th>
                        <th>Super</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>
<script>
    $(function () {
        $(".EditPlace").hide();
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/Common/SymUserRoll/_indexGrouplist",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "2%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    //return ' <a title="Click for Details" style="text-decoration:none" value="' + oObj.aData[0] + '"  href=\"/Common/SymUserRoll/SelectUserForRoll/' + oObj.aData[0] + '\"     class="sym-btn-detail-row"></a>';
                                    return ' <a title="Click for Details" style="text-decoration:none" value="' + oObj.aData[0] + '" Onclick="SelectemployeeFilter(\'' + oObj.aData[0] + '\')"      class="sym-btn-detail-row"></a>';
                                }
                            }
                                , { "sName": "GroupName", "sWidth": "15%" }
                                , { "sName": "IsSuper", "sWidth": "20%" }
            ]
        });
        oTable.columnFilter({
            sPlaceHolder: "head:after",
            aoColumns: [{ type: "checkbox", "sClass": "chkAll" }
                       , { type: "text" }
                       , { type: "text" }
            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
    function CancleUser() {
        $(".EditPlace").hide();
    }
    function SelectemployeeFilter(Sender) {
        //var Id = $("#Id").val();
        var url = "/Common/SymUserRoll/SelectUserForRollfilter?Id=" + Sender;
        $.ajax({
            url: url,
            type: 'GET',
            beforeSend: function () { $(".loading").show(); },
            complete: function () { $(".loading").fadeOut(200).hide("slow") },
            success: function (data) {
                $('#Detaildiv').html(data);
            },
        });
    }
</script>

<style>
    div > input[type="checkbox"] {
        text-align: center;
        margin: 0 !important;
    }

    .profileImageright {
        max-width: 130px;
    }

    .employee-image-card {
        margin-top: 20px;
        background: #f8faff;
        border-radius: 12px;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        width: 125px;
    }

    /* Upload Box */
    .image-wrapper {
        position: relative;
        width: 100%;
        height: 140px;
        border: 2px dashed #2e6fd8;
        border-radius: 10px;
        overflow: hidden;
        background: #eef3fb;
    }

        .image-wrapper.has-image {
            border: 0;
        }

    .upload-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .upload-content p {
            font-size: 14px;
            text-align: center;
        }

        .upload-content i {
            font-size: 18px;
        }

    .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: none;
    }


    .image-wrapper.has-image img {
        display: block;
    }

    .image-wrapper.has-image .upload-content {
        display: none;
    }


    .image-wrapper input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .d-none {
        display: none !important;
    }
    /* File Info */
    .file-info {
        margin-top: 8px;
        padding: 5px 8px;
        background: #e3ebf7;
        border-radius: 6px;
        display: flex;
        align-items: center;
        font-size: 12px;
    }

    .file-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    div > input[type="checkbox"] {
        width: 27px !important;
    }
</style>

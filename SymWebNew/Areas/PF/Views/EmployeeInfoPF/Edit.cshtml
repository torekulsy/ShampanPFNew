    <script>
        $(function () {
            valiDation("frmEmployeeInfoForPFEdit");
        });


        $("#IsProfit").change(function () {
            if ($(this).is(":checked")) {
                $("#IsNoInterest").prop("disabled", true);
            } else {
                $("#IsNoInterest").prop("disabled", false);
            }
        });

        $("#IsNoInterest").change(function () {

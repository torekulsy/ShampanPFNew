@{
    ViewBag.Title = "Import";
}

<style>
    .importnandexport {
        display: flex;
        justify-content: center;
        align-items: center;
        column-gap: 10px;
    }
</style>

<div class="th_thinbox_top" style="display: flex; justify-content: flex-end">

    <div class="breadcrumb-container">
        <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
    </div>
</div>
<div class="thinbox mt-2" id="EmployeeInfoImportExportPage">
    <div class="th_thinbox">
        <p>Employee Import / Export</p>

    </div>
    <div class="card-body">
        @using (Ajax.BeginForm("UploadExcel", "EmployeeInfoPF", null, new AjaxOptions { }, new { enctype = "multipart/form-data", id = "frmUploadExcel" }))
        {
            <div class="importnandexport">
                <div class="">
                    <label>File</label>
                    <input type="File" accept=".xlsx" name="file" id="FileUpload" class="required importRequired" />
                </div>
                <div class="">
                    <label>&nbsp;</label>
                    @*<button type="button" onclick="pageSubmit('frmUploadExcel');" title="Bonus Import" class="sym-btn-file-upload" value="Upload">&nbsp;Upload</button>*@
                    <button type="button"
                            onclick="return validateUpload('frmUploadExcel');"
                            title="Bonus Import"
                            class="sym-btn-file-upload">
                        &nbsp;Upload
                    </button>
                    
                </div>
                <div class="">
                    <label>&nbsp;</label>
                    
                    <button type="button" title="Export Data" onclick="ExportExcell()" class="sym-btn-Excel-Export">&nbsp;Export</button>
                </div>
            </div>
        }
    </div>
</div>
<script>
    $(function () {
        valiDation('EmployeeInfoImportExportPage');
    });

    function ExportExcell() {
        var questionMSG = "Are you sure you want to export data?";
        Ask(questionMSG, function () {
            window.location.href = '/EmployeeInfoPF/ExportExcell'; // Ensure correct controller name
        });
    }

    function validateUpload(formId) {
        if (!validateRequiredFields("#EmployeeInfoImportExportPage", ".importRequired")) {
            return false;
        }

        pageSubmit(formId);
        return true;
    }
</script>

<style>
    .main-sidebar {
        font-size: 14px;
    }



    .nav-sidebar .nav-link:hover {
        background-color: #17A2ED !important;
        color: white !important;
    }

    .brand-link {
        font-size: 18px;
        font-weight: 600;
    }

    .sidebar {
        height: calc(100vh - 118px) !important;
        width: 247px !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }

    .main-sidebar .brandLogo {
        background: #fff;
        text-align: center;
        padding: 3px;
        display: block;
        margin: 7px;
        height: 62px;
        border-radius: 4px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .main-sidebar .brandLogo img {
            margin: auto;
            max-height: 100%;
        }


    /* Child Menu Indentation */
    .nav-treeview {
        padding-left: 16px !important;
    }

    .has-treeview-a.treeview-expanded.nav-treeview {
        padding-left: 20px !important;
    }
    /* Every Child Menu Item */
    .nav-treeview > .nav-item {
        position: relative !important;
    }

        /* Horizontal Line */
        .nav-treeview > .nav-item::before {
            content: "" !important;
            position: absolute !important;
            left: -8px !important;
            top: 20px !important;
            width: 8px !important;
            border-top: 1px solid #fff !important;
        }

        /* Vertical Line */
        .nav-treeview > .nav-item::after {
            content: "" !important;
            position: absolute !important;
            left: -8px !important;
            top: 0 !important;
            height: 100% !important;
            border-left: 1px solid #fff !important;
        }

        /* Last Child */
        .nav-treeview > .nav-item:last-child::after {
            height: 20px !important;
        }
</style>

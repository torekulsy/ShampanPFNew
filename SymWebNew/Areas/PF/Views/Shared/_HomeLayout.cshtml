    <script type="text/javascript">
        $(document).ready(function () {

            $(".nav-treeview").hide();

            var expandedMenu = localStorage.getItem("expandedMenu");
            var expandedSubMenu = localStorage.getItem("expandedSubMenu");
            var activeMenu = localStorage.getItem("activeMenu");

            function setMenuArrow($el, isOpen) {
                $el.children("p")
                    .children("i.right")
                    .removeClass(isOpen ? "fa-angle-left" : "fa-angle-down")
                    .addClass(isOpen ? "fa-angle-down" : "fa-angle-left");
            }

            function openMenu($el) {
                $el.addClass("treeview-expanded");
                $el.next(".nav-treeview").show();

                setMenuArrow($el, true);
            }

            // =========================
            // RESTORE MENU STATE
            // =========================
            if (expandedMenu) {
                openMenu($('[data-menu-id="' + expandedMenu + '"]'));
            }

            if (expandedSubMenu) {
                openMenu($('[data-menu-id="' + expandedSubMenu + '"]'));
            }

            // =========================
            // RESTORE ACTIVE STATE
            // =========================
            if (activeMenu) {

                var $active = $('[data-menu-id="' + activeMenu + '"]');

                $(".nav-link").removeClass("active-menu");
                $(".has-treeview-a").removeClass("last-parent-active");

                $active.addClass("active-menu");

                $active.parents(".nav-treeview").show();

                $active.parents("li")
                    .children(".has-treeview, .has-treeview-a")
                    .each(function () {

                        $(this).addClass("treeview-expanded");

                        setMenuArrow($(this), true);
                    });

                // Last Parent Highlight
                var $lastParent = $active
                    .closest(".nav-treeview")
                    .prev(".has-treeview-a");

                if ($lastParent.length) {
                    $lastParent.addClass("last-parent-active");
                }
            }

            // =========================
            // PARENT MENU
            // =========================
            $("body").on("click", ".has-treeview", function (e) {

                e.preventDefault();
                e.stopPropagation();

                var $this = $(this);
                var $target = $this.next(".nav-treeview");
                var menuId = $this.data("menu-id");

                if ($this.hasClass("treeview-expanded")) {

                    $this.removeClass("treeview-expanded");

                    $target.slideUp(200);

                    setMenuArrow($this, false);

                    localStorage.removeItem("expandedMenu");
                }
                else {

                    $(".has-treeview").not($this).each(function () {

                        $(this)
                            .removeClass("treeview-expanded")
                            .next(".nav-treeview")
                            .slideUp(200);

                        setMenuArrow($(this), false);
                    });

                    $this.addClass("treeview-expanded");

                    $target.slideDown(200);

                    setMenuArrow($this, true);

                    localStorage.setItem("expandedMenu", menuId);
                }
            });

            // =========================
            // SUB MENU
            // =========================
            $("body").on("click", ".has-treeview-a", function (e) {

                e.preventDefault();
                e.stopPropagation();

                var $this = $(this);
                var $target = $this.next(".nav-treeview");
                var menuId = $this.data("menu-id");

                if ($this.hasClass("treeview-expanded")) {

                    $this.removeClass("treeview-expanded");

                    $target.slideUp(200);

                    setMenuArrow($this, false);

                    localStorage.removeItem("expandedSubMenu");
                }
                else {

                    $this.closest(".nav-treeview")
                        .find("> li > .has-treeview-a")
                        .not($this)
                        .each(function () {

                            $(this)
                                .removeClass("treeview-expanded")
                                .next(".nav-treeview")
                                .slideUp(200);

                            setMenuArrow($(this), false);
                        });

                    $this.addClass("treeview-expanded");

                    $target.slideDown(200);

                    setMenuArrow($this, true);

                    localStorage.setItem("expandedSubMenu", menuId);
                }
            });

            // =========================
            // ACTIVE MENU CLICK
            // =========================
            // =========================
            // ACTIVE MENU CLICK
            // =========================
            $("body").on("click", ".nav-link", function () {

                var menuId = $(this).data("menu-id");

                if (
                    !$(this).hasClass("has-treeview") &&
                    !$(this).hasClass("has-treeview-a")
                ) {

                    $(".nav-link").removeClass("active-menu");
                    $(".has-treeview-a").removeClass("last-parent-active");

                    $(this).addClass("active-menu");

                    // Last Parent Highlight
                    var $lastParent = $(this)
                        .closest(".nav-treeview")
                        .prev(".has-treeview-a");

                    if ($lastParent.length) {
                        $lastParent.addClass("last-parent-active");
                    }

                    // =========================
                    // CLOSE SIBLING SUBMENUS
                    // =========================
                    var $currentLi = $(this).closest("li");

                    $currentLi.siblings("li").each(function () {

                        var $submenu = $(this).children(".has-treeview-a");
                        var $submenuTree = $(this).children(".nav-treeview");

                        if ($submenu.length > 0) {

                            $submenu.removeClass("treeview-expanded");

                            setMenuArrow($submenu, false);

                            $submenuTree.slideUp(200);
                        }
                    });

                    // expanded submenu remove
                    localStorage.removeItem("expandedSubMenu");

                    localStorage.setItem("activeMenu", menuId);
                }
            });

        });
        $(document).ready(function () {
            $(".customDatePicker").datepicker({
                dateFormat: "dd-M-yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "1900:2500",
            });
            $(".noFutureDate").datepicker("option", {
                maxDate: 0,
                yearRange: "1900:+0"
            });

            $(".noBeforeDate").datepicker("option", {
                minDate: 0,
                yearRange: "1900:+0"
            });

            $(".FromDate").on("change", function () {
                
                var fromDate = $(this).datepicker("getDate");

                if (fromDate) {

                    $(".ToDate").datepicker("option", "minDate", fromDate);
                    var toDate = $(".ToDate").datepicker("getDate");
                    if (toDate && toDate < fromDate) {
                        $(".ToDate").val('');
                    }
                }
            });


            $(".ToDate").on("change", function () {
                var fromDate = $(this).datepicker("getDate");

                if (fromDate) {

                    $(".MaturityDate").datepicker("option", "minDate", fromDate);
                    var toDate = $(".MaturityDate").datepicker("getDate");
                    if (toDate && toDate < fromDate) {
                        $(".MaturityDate").val('');
                    }
                }
            });

        });

        $(document).ready(function () {
            $(document).on('keypress', '.isPositiveNumeric', function (e) {
                var charCode = e.which;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                    e.preventDefault();
                }
            });
            $(document).on('input', '.isPositiveNumeric', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });
    </script>


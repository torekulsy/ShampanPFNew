    <script>

        $(document).ready(function () {

            $("#btnLeftMenu").click(function () {

                $("body")
                    .removeClass("layout-top")
                    .addClass("layout-left");

                // AdminLTE content mode
                $(".content-area")
                    .addClass("content-wrapper");

                localStorage.setItem("layoutMode", "left");
            });

            $("#btnTopMenu").click(function () {

                $("body")
                    .removeClass("layout-left sidebar-collapse")
                    .addClass("layout-top");

                // REMOVE adminlte wrapper
                $(".content-area")
                    .removeClass("content-wrapper");

                localStorage.setItem("layoutMode", "top");
            });

            // Load Saved Mode
            var savedMode = localStorage.getItem("layoutMode");

            if (savedMode === "top") {

                $("body").removeClass("layout-left").addClass("layout-top");
                $(".content-area").removeClass("content-wrapper");

            } else {

                $("body").addClass("layout-left");
                $(".content-area").addClass("content-wrapper");

            }

        });


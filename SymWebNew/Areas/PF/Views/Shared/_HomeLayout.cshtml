    <style>
        .LogoutButton {
            width: 24px;
            height: 24px;
            border-radius: 5px;
            padding-left: -3px !important;
        }

        .wth {
            width: 15%;
        }
        /* Layout Wrapper */
        .layout-wrapper {
            min-height: 100vh;
            background: #f4f6f9;
        }

        /* Header */
        .layout-top .main-header {
            height: 60px;
            background: linear-gradient(90deg, #1d3557, #457b9d);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            color: white;
            width: 90%;
            margin: 0 auto !important;
        }

        .layout-left .main-header {
            height: 60px;
            background: linear-gradient(90deg, #1d3557, #457b9d);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            color: white;
        }
        /* Container */
        .main-container {
            display: flex;
            transition: all 0.3s ease;
        }

        /* Left Sidebar */
        .left-sidebar {
            width: 250px;
            background: #1d3557;
            color: white;
            min-height: calc(100vh - 60px);
            transition: 0.3s;
        }

        /* Content */
        .layout-left .content-area {
            flex: 1;
            padding: 20px;
            background: #ffffff;
        }

        /* Top Menu */
        .top-menu {
            display: none;
        }

        /* ===== Layout Modes ===== */

        /* Left Menu Mode */
        .layout-left .left-sidebar {
            display: block;
        }

        .layout-left .top-menu {
            display: none;
        }

        /* Top Menu Mode */
        .layout-top .left-sidebar {
            display: none;
        }

        .layout-top .top-menu {
            display: block;
        }
    </style>


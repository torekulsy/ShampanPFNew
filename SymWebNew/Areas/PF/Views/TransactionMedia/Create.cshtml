@model SymViewModel.PF.TransactionMediaVM
@using UIHelper.MVC
@{

    ViewBag.Title = "Create";
    ViewBag.Location = "Create"; 
}

@using (Html.BeginForm("CreateEdit", "TransactionMedia", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmTransactionMedia" }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Operation)

    <div class="">
        <div class="EnumTransactionMedia">
            <div class="row">
                <label class="col-sm-3">
                    @Html.LabelFor(model => model.Name)
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.Name, new { @placeholder = "Transaction Media", @class = "required form-control" })
                </div>
            </div>
            @if (Model.Operation != "add")
            {
                <div class="row">
                    <label class="col-sm-3">
                        @Html.LabelFor(model => model.IsActive)
                    </label>
                    <div class="col-sm-9">
                        @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IsActive)
                    </div>
                </div> 
            }
            <div class="row mt-2">
                <label class="col-sm-3">
                    @Html.LabelFor(model => model.Remarks)
                </label>
                <div class="col-sm-9">
                    @Html.TextAreaFor(model => model.Remarks, new { @placeholder = "Remarks", @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Remarks)
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-sm-12">
                    <div class="reportModalbtn">
                        @if (Model.Operation == "add")
                        {
                            <button type="button" title="Save Data" onmousedown="return confirmTransactionMediaSave(event);" class="sym-btn-save">&nbsp;Save</button>
                        }
                        else
                        {
                            <button type="button" title="Update Data" onmousedown="return confirmTransactionMediaSave(event);" class="sym-btn-update">&nbsp;Update</button>
                        }

                        <button type="button" title="Cancel Data" class=" btncancel sym-btn-cancel">&nbsp;Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script>
    function confirmTransactionMediaSave(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        if (!validateRequiredFields("#frmTransactionMedia")) {
            return false;
        }

        var operation = ($("#Operation").val() || "add").toLowerCase();
        var actionName = operation === "update" ? "Update" : "Save";
        var dialogContent = $("#frmTransactionMedia").closest(".ui-dialog-content");
        var dialogWrapper = dialogContent.closest(".ui-dialog");
        var dialogOverlay = $(".ui-widget-overlay:visible").last();

        $("#frmTransactionMedia :focus").trigger("change").blur();
        dialogWrapper.hide();
        dialogOverlay.hide();

        setTimeout(function () {
            Ask("Are you sure you want to " + actionName + " the Transaction Media?", function () {
                pageSubmit("frmTransactionMedia");
            }, function () {
                dialogOverlay.show();
                dialogWrapper.show();
                dialogContent.dialog("moveToTop");
            });
        }, 50);

        return false;
    }

    $(function () {
        InitDropDowns();
        valiDation("frmTransactionMedia");
    });

</script>

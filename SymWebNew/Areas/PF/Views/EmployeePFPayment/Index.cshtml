@using UIHelper.MVC
@using System.Threading;
@using NPOI.SS.Formula.Functions
@using UIHelper.MVC
@using SymOrdinary
@{
    ViewBag.Title = "Index";
}
@{
    ShampanIdentity identity = null;
    try
    {
        identity = (ShampanIdentity)Thread.CurrentPrincipal.Identity;
    }
    catch (Exception)
    {
        Response.Redirect("/Home/Index");
        return;
    }
}

<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Employee PF Payment</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox">
    <div class="custom-top">
        <div id="mainBtnAll">
            <button type="button" title="Add New Employee PF Payment" data-url="/@ViewBag.TransType/EmployeePFPayment/SingleEmployeePFPaymentEdit?PFOpeinigId=&Operation=add" onclick="GoTo(this)" id="" class="sym-btn-add ">&nbsp;New</button>
            <button type="button" title=" Import/Export" id="" class="sym-btn-ExportImport" data-url="/@ViewBag.TransType/EmployeePFPayment/ImportEmployeePFPayment" onclick="GoTo(this)">&nbsp;Import/Export</button>
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>
    <div id="container">
        <table id="myDataTable" class="display">
            <thead>
                <tr>
                    <th class="center">Actions</th>
                    <th class="center">Code</th>
                    <th class="center">Name</th>
                    <th class="center">Employee Contribution</th>
                    <th class="center">Employer Contribution</th>
                    <th class="center">Employee Profit</th>
                    <th class="center">Employer Profit</th>
                    <th class="center">Date</th>
                    <th class="center">Post</th>
                    
                </tr>
               
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>
<div class="card mt-3">
    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New Employee PF Payment" data-url="/@ViewBag.TransType/EmployeePFPayment/SingleEmployeePFPaymentEdit?PFOpeinigId=&Operation=add" onclick="GoTo(this)" id="" class="sym-btn-add ">&nbsp;New</button>
            <button type="button" title=" Import/Export" id="" class="sym-btn-ExportImport" data-url="/@ViewBag.TransType/EmployeePFPayment/ImportEmployeePFPayment" onclick="GoTo(this)">&nbsp;Import/Export</button>
        </div>
    </div>
</div>

<script>
    $(function () {

        SelectAllForDelete();
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/@ViewBag.TransType/EmployeePFPayment/_index",
                "bProcessing": true,
                "aLengthMenu": tablelength(),
                "bJqueryUI": true,
                "bAutoWidth": false,

                "bPaginate": true,
                "sPaginationType": "full_numbers",
                "iDisplayLength": 10,
                "oLanguage": {
                    "oPaginate": {
                        "sPrevious": '<i class="fa fa-angle-left"></i>',
                        "sNext": '<i class="fa fa-angle-right"></i>'
                    },
                    "sSearch": ""
                },

                "fnDrawCallback": function () {
                    $('.dataTables_filter input')
                        .attr('placeholder', 'Search...');
                },
                "aoColumns": [
                     {
                         "sName": "Id",
                         "bSearchable": false,
                         "bSortable": false,
                         "sWidth": "5%",
                         "sClass": "center",
                         "fnRender": function (oObj) {

                             if ('@identity.IsAdmin'.toLowerCase() == "true")
                             {
                                 var editLink = '  &nbsp;  <a title="Click on for Edit" id="lnkEdit1" style="text-decoration:none;" Onclick="otherearningEdit(this);"  class=" sym-btn-edit-row"  data-Id="' + oObj.aData[0] + '"></a>';

                                 if (oObj.aData[8] === "Posted") {
                                     return editLink
                                         + '&nbsp; <span title="Data already posted" class="sym-btn-post-row employee-payment-post-disabled" aria-disabled="true" style="opacity:0.45;pointer-events:none;cursor:default;"></span>';
                                 }

                                 return editLink
                                     + '&nbsp; <a title="Click on for Post" style="text-decoration:none;" data-url="/@ViewBag.TransType/EmployeePFPayment/MultiplePost" data-id="' + oObj.aData[0] + '" onclick="postEmployeePFPayment(this);" class="sym-btn-post-row"></a>';
                             }
                             else {
                                 return '  &nbsp;  <a title="Click on for Edit" id="lnkEdit1" style="text-decoration:none;" Onclick="otherearningEdit(this);"  class=" sym-btn-edit-row"  data-Id="' + oObj.aData[0] + '"></a>';
                             }
                            
                         }
                     }
                      , { "sName": "Code", "sWidth": "10%" }
                                , { "sName": "Name", "sWidth": "14%" }
                                , {
                                    "sName": "EmployeeContribution", "sWidth": "10%", "sType": "numeric", "sClass": "right", "fnRender": function (oObj) {
                                        return formatNumberWithCommas(oObj.aData[3]);
                                    }
                                }
                                , {
                                    "sName": "EmployerContribution", "sWidth": "10%", "sType": "numeric", "sClass": "right", "fnRender": function (oObj) {
                                        return formatNumberWithCommas(oObj.aData[4]);
                                    }
                                }
                                , {
                                    "sName": "EmployeeProfit", "sWidth": "10%", "sType": "numeric", "sClass": "right", "fnRender": function (oObj) {
                                        return formatNumberWithCommas(oObj.aData[5]);
                                    }
                                }
                                , {
                                    "sName": "EmployerProfit", "sWidth": "10%", "sType": "numeric", "sClass": "right", "fnRender": function (oObj) {
                                        return formatNumberWithCommas(oObj.aData[6]);
                                    }
                                }
                                , { "sName": "OpeningDate", "sClass": "center", "sWidth": "10%" }
                                , { "sName": "Post", "sClass": "right", "sWidth": "18%" }
                ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
            
        });
        function otherearningEdit(sender) {
            window.location = "/@ViewBag.TransType/EmployeePFPayment/SingleEmployeePFPaymentEdit?PFPaymentId=" + $(sender).attr('data-Id');
        }

    function formatNumberWithCommas(value) {
        if (value == null || value === '') return '';
        value = parseFloat(value).toFixed(2);
        var parts = value.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts[0] + '.' + parts[1];
    }

    function postEmployeePFPayment(sender) {
        var $sender = $(sender);
        var id = $sender.attr("data-id");

        if (!id || $sender.hasClass("employee-payment-posting")) {
            return false;
        }

        Ask("Are you sure to Post!", function () {
            $sender.addClass("employee-payment-posting")
                .css({ "pointer-events": "none", "opacity": "0.45" });

            $.ajax({
                url: $sender.attr("data-url"),
                type: "POST",
                dataType: "json",
                data: { ids: id },
                success: function (result) {
                    var status = result && result.length > 0 ? result[0] : "Fail";
                    var message = result && result.length > 1 ? result[1] : "Unable to post data.";

                    ShowResult(status, message);
                    if (status === "Success") {
                        setTimeout(function () { location.reload(); }, 1000);
                        return;
                    }

                    $sender.removeClass("employee-payment-posting")
                        .css({ "pointer-events": "", "opacity": "" });
                },
                error: function () {
                    ShowResult("Fail", "Unable to post data. Please try again.");
                    $sender.removeClass("employee-payment-posting")
                        .css({ "pointer-events": "", "opacity": "" });
                }
            });
        }, function () { });

        return false;
    }
</script>

@model SymViewModel.PF.PFReportVM
@using UIHelper.MVC
@{

    ViewBag.Title = "Create";
    ViewBag.Location = "Create";
}



@using (Html.BeginForm("PFContribution_Statement", "PFReport", FormMethod.Post, new { area = "PF", enctype = "multipart/form-data", @Id = "frmStatement" }))
{
    @Html.ValidationSummary(true)
    @*@Html.HiddenFor(model => model.Id)*@
   <h4> Contribution Report</h4>
    <div class="">
        <div class="EnumEEHead mt-2">
            <div class="row mt-2">
                <label class="col-sm-3">
                    <label>Code</label>
                </label>
                <div class="col-sm-9">
                    @*@Html.TextBoxFor(model => model.Code, new { @placeholder = "Code", @class = " form-control" })*@
                    @Html.SimpleDropDownFor(model => model.EmployeeId, "/Config/DropDown/EmployeeCodeNameId", new { @class = "required codeFCom form-control selectDropdown" })
                    @Html.ValidationMessageFor(model => model.EmployeeId)
                </div>
            </div>
            
            @*<div class="row">
                <div class="col-md-12">
                    <div class="editor-label">
                        <label>Employee Code</label>
                    </div>
                    <div class="editor-field">
                        @Html.SimpleDropDownFor(model => model.EmployeeId, "/Config/DropDown/EmployeeCodeNameId", new { @class = "codeFCom form-control selectDropdown" })
                    </div>

                </div>
                </div>*@
            <div class="row mt-2">

                <label class="col-sm-3">
                    @Html.LabelFor(model => model.DateFrom)
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.DateFrom, new { @placeholder = "Date From", @class = "customDatePicker form-control" })
                    @Html.ValidationMessageFor(model => model.DateFrom)
                </div>
            </div>

            <div class="row mt-2">
                <label class="col-sm-3">
                    @Html.LabelFor(model => model.DateTo)
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.DateTo, new { @placeholder = "Date To", @class = "customDatePicker form-control" })
                    @Html.ValidationMessageFor(model => model.DateTo)
                </div>
            </div>
                <div class="row">
                    &nbsp;
                </div>


                <div class="row">
                    <div class="col-12">
                        <div class="reportModalbtn">
                            @*<button type="button" title="Report Preview" onclick="pageSubmit('frmCOAGroup');" class="sym-btn-save">&nbsp;Preview</button>*@
                            <button type="button" title="Click for Report" data-url="/@ViewBag.TransType/PFReport/PFContribution_Statement" onclick="reportData(this);" id="" class="sym-btn-Excel-Export">&nbsp;Download</button>


                            <button type="button" title="Clear the Entries" id="Clear" class="sym-btn-clear">&nbsp;Clear</button>


                            <button type="button" title="Cancel Data" class=" btncancel sym-btn-cancel">&nbsp;Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
    </div>
}
<script>
    $(function () {
        $(".selectDropdown").select2();
        $(".selectDropdown").removeClass('form-control');
        InitDropDowns();
        InitDateTimePickers();
        $(".selectDropdown").on("change", function () {
            $(this).valid();
        });

        $("#Clear").on('click', function () {
            $("#frmStatement").find("input[type=text], select, textarea").val("");
            $("#frmStatement").find("select").val(null).trigger('change');
        });
    });

    function reportData(sender) {

        var isValid = $("#frmStatement").valid();


        // valiDation("frmStatement");
        // var isValid = $("#frmStatement").validate().form();

        if (isValid) {
            $("#frmStatement").submit();
        } else {
            console.log("Form validation failed. Prevention active.");
        }
    }
</script>


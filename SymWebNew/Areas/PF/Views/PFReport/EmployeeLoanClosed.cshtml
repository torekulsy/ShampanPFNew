@using UIHelper.MVC
@{
    ViewBag.Title = "EmployeeLoanClosed";
}

@using (Html.BeginForm("EmployeeLoanClosed", "PFReport", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmEmployeeLoanClosed", @target = "_blank" }))
{
    <div class="card">
        <div class="card-header p-3">
            <div class="th_thinbox_top" style="justify-content:flex-end">
                <div class="breadcrumb-container">
                    <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
                </div>
            </div>
        </div>
    </div>
    <div class="thinbox">
        <div class="th_thinbox">
            <p>Employee PF Statement</p>
        </div>
        <div class="Withdraw card-body">
            <div class="row">

                <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3">
                    <div class="editor-label">
                        <label>From Date</label>
                    </div>
                    <div class="editor-field">
                        @Html.TextBox("DateFrom", "", new { @placeholder = "From Date", @class = " dtFrom customDatePicker form-control" })
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3">
                    <div class="editor-label">
                        <label>To Date</label>
                    </div>
                    <div class="editor-field">
                        @Html.TextBox("DateTo", "", new { @placeholder = "To Date", @class = " dtTo customDatePicker form-control" })
                    </div>
                </div>


            </div>
            <div class="headrow mt-4">
                <button type="button" title="Click to View Report Summary" class="sym-btn-report btnSummary">&nbsp;Report</button>
            </div>
        </div>
    </div>

   
}

<script>

    $(function () {


        $('.btnSummary').click(function () {


            var ToDate = $('.dtTo').val();
            var FromDate = $('.dtFrom').val();

            if (FromDate == "") {
                ShowResult("Fail", "Please select From Date !");
                return;
            }
            if (ToDate == "") {
                ShowResult("Fail", "Please select To Date !");
                return;
            }
            //alert(empId);

            var url = "/@ViewBag.TransType/PFReport/EmployeeLoanClosed?rType=" + "Summary" + '&ToDate=' + ToDate + '&FromDate=' + FromDate;
            var win = window.open(url, '_blank');
        });
    });
</script>


<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>COA</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox">
    <div class="th_thinbox">
        <p>COA List</p>
    </div>
    <div class="custom-top">
        <div id="mainBtnAll">
            <button type="button" title="Add New COA" data-url="/@ViewBag.TransType/COA/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>
    <table id="myDataTable" class="display">
        <thead>
            <tr>
               
                <th class="center">Action </th>
                <th class="left">Code </th>
                <th class="left">Name </th>
                <th class="left">Group Name </th>
                <th class="left">Type </th>
                <th class="left">Nature </th>
                <th class="left">Retained Earning </th>
                <th class="left">Net Profit </th>
                <th class="left">Depreciation </th>
                <th class="left">COASL </th>
                <th class="left">Active/Inactive</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>
<div class="card mt-3">
    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New COA" data-url="/@ViewBag.TransType/COA/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
        </div>
    </div>
</div>

<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/@ViewBag.TransType/COA/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "5%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    return ' <a id=""  title="Click on for Edit"  style="text-decoration:none;"  href=\"/@ViewBag.TransType/COA/Edit/' + oObj.aData[0] + '\" class="  sym-btn-edit-row"></a>' +
                                   ' ';
                                }
                            }
                            , { "sCode": "Code ", "sWidth": "7%" }
                            , { "sName": "Name ", "sWidth": "10%" }
                            , { "sGroupName": "GroupName ", "sWidth": "8%" }
                            , { "sCOAType": "COAType ", "sWidth": "6%" }
                            , { "sNature": "Nature ", "sWidth": "7%" }
                            , { "sIsRetainedEarning": "IsRetainedEarning ", "sWidth": "10%" }
                            , { "sIsNetProfit": "IsNetProfit ", "sWidth": "10%" }
                            , { "sIsDepreciation": "IsDepreciation ", "sWidth": "12%" }
                            , { "sCOASL": "COASL ", "sWidth": "10%" }
                            , { "sIsActive": "IsActive", "sWidth": "12%" }
            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>


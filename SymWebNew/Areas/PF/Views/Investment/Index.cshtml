                                "sClass": "left",
                               fnRender: function (oObj) {
    var result = '';

    // Admin check
    if ('@identity.IsAdmin'.toLowerCase() == "true") {
        if (oObj.aData[8] == "Posted") {
            // Show the "Post" button with disabled style (when already posted)
            result += '&nbsp; <a title="Click on for Post" data-url="/@ViewBag.TransType/Investment/Post" onclick="btnPostNew(this);" data-Id="' + oObj.aData[0] + '" class="sym-btn-post-row" style="opacity:0.45;pointer-events:none;cursor:default;"></a>';
        } else {
            // Show the active "Post" button (when not posted yet)
            result += '&nbsp; <a title="Click on for Post" data-url="/@ViewBag.TransType/Investment/Post" onclick="btnPostNew(this);" data-Id="' + oObj.aData[0] + '" class="sym-btn-post-row"></a>';
        }
    }

    // Always show the following buttons
    result += '&nbsp; <a title="Click on for Journal" href="/@ViewBag.TransType/Investment/JournalEntry?TransactionId=' + oObj.aData[0] + '&Code=' + oObj.aData[2] + '" class="sym-btn-bank-row"></a>'
        + '&nbsp; <a title="Click on for Edit" href="/@ViewBag.TransType/Investment/Edit/' + oObj.aData[0] + '" class="sym-btn-edit-row"></a>'
        + '&nbsp; <a title="Click on for Report" href="/@ViewBag.TransType/Investment/reportVeiw/' + oObj.aData[0] + '" class="linkReport sym-btn-report-row"></a>'
        + '&nbsp; <a title="Click on for Renew/Encash" target="_blank" href="/@ViewBag.TransType/InvestmentRenew/Index?investmentId=' + oObj.aData[0] + '" class="sym-btn-add-row"></a>';

    return result;
}



                            }

                            , { "sName": "ReferenceNo", "sWidth": "10%" }
                            , { "sName": "TransactionCode", "sWidth": "10%" }
                            , { "sName": "InvestmentType", "sWidth": "10%" }
                            , { "sName": "InvestmentName", "sWidth": "18%" }
                            , { "sName": "InvestmentDate", "sWidth": "10%" }
                            , { "sName": "MaturityDate", "sWidth": "10%" }
                            , {
                                "sName": "InvestmentValue", "sWidth": "10%", "sClass": "right", "fnRender": function (oObj) {
                                    return formatNumberWithCommas(oObj.aData[7]);
                                }
                            }
                            , { "sName": "Post", "sWidth": "8%" }
                            , { "sName": "Approve", "sWidth": "10%" }
                            , { "sName": "IsEncashed", "sWidth": "10%" }

            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>


<script>
    function btnPostNew(sender) {

        var Id = $(sender).attr("data-Id");

        var getURL = "/@ViewBag.TransType/Investment/GetInvestment" + "?" + "id=" + Id;

        $.getJSON(getURL, function (vm) {

            if (vm.Post) {
                ShowResult("Fail", "Data Already Posted!");
                return true;
            }
            else {
                var url = $(sender).attr("data-url") + "?ids=" + Id + '~';
                var questionMSG = "Are you sure to Post Data!";
                singleOperation(questionMSG, url);
            }

        });

    }


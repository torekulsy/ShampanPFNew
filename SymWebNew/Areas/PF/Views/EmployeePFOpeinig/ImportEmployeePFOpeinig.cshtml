@using UIHelper.MVC

@{
    ViewBag.Title = "ImportEmployeePFOpeinig";
}
<style>
    .thinbox{
        height: 100%
    }
</style>
<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Employee PF Opening</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox" id="EmployeePFOpeningImportExportPage">
    
    <div class="card-body">
        <button type="button" title="Go To Index" data-url="/@ViewBag.TransType/EmployeePFOpeinig" onclick="GoTo(this)" class="sym-btn-detail">&nbsp;Index</button>
        <div class="row mt-2">
            <div class="col-md-4">
                <div class="thinbox">
                    <div class="th_thinbox">
                        <p>Employee PF Opening Import</p>
                    </div>
                    <div class="card-body">
                       
                            @using (Ajax.BeginForm("ImportExcel", "EmployeePFOpeinig", null, new AjaxOptions { }, new { enctype = "multipart/form-data", id = "ImportEmployeePFOpeinigExcel" }))
                        {
                                 <div class="row">
                                <div class="col-md-12"> </div>
                               

                                    <div class="col-md-12">
                                        <div class="editor-label">
                                            <label>File</label>
                                            </div>
                                            <input type="file" accept=".xlsx" name="file" id="FileUpload" style="width: 100%;" class="required importRequired" />
                                        </div>
                             
                                <div class="col-md-12">

                                    <label>&nbsp;</label>
                                    @*<button type="button" onclick="pageSubmit('ImportOtherEarningExcel');" class="sym-btn-file-upload" value="Upload" style="width: 50%; text-align: center;">&nbsp;Upload</button>*@
                                    <button type="button" onclick="ImportExcle();" class="sym-btn-file-upload" value="Upload" >&nbsp;Upload</button>
                                </div>
                                </div>
                        }
                        
                    </div>
                </div>
            </div>


            <div class="col-md-8">
                <div class="thinbox">
                    <div class="th_thinbox">
                        <p>Employee PF Opening Export</p>
                    </div>
                    <div class="row">



                    </div>
                    <div class="card-body">
                        <div class="row">

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>Employee Code(From)</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("CodeF", "/Config/DropDown/EmployeeCodeName", new { @class = "codeFCom form-control selectDropdown" })
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>Employee Code(To)</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("CodeT", "/Config/DropDown/EmployeeCodeName", new { @class = "codeTCom form-control selectDropdown" })

                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>Designation</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("DesignationId", "/Config/DropDown/Designation", new { @class = " form-control" })
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>@Session["DepartmentLabel"]</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("DepartmentId", "/Config/DropDown/Department", new { @class = "departmentsCom form-control" })
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>@Session["SectionLabel"]</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("SectionId", "/Config/DropDown/Section", new { @class = "sectionsCom form-control" })
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>@Session["ProjectLabel"]</label>
                                </div>
                                <div class="editor-field">
                                    @Html.SimpleDropDown("ProjectId", "/Config/DropDown/Project", new { @class = "projectsCom form-control" })
                                </div>
                            </div>
                            @*<div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                            <div class="editor-label">
                                <label>Earning Type</label>
                            </div>
                            <div class="editor-field">
                                @Html.SimpleDropDown("EarningTypeId", "/Config/DropDown/EarningTypeDropDown", new { @id = "ETId", @class = "required EarningTypeId eType form-control" })
                            </div>
                        </div>*@
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4">
                                <div class="editor-label">
                                    <label>Order By</label>
                                </div>
                                <div class="editor-field">
                                @Html.SimpleDropDown("Orderby", "/Config/DropDown/EnumOrderBy?Module=Salary", new { @class = "required exportRequired form-control" })
                                </div>
                            </div>
                        </div>

                        <br />
                        <div class="row">
                            <div class="col-12 col-sm-6 col-md-6">
                                <label>&nbsp;</label>
                                <button id="btnExportFormEmployee" class="sym-btn-Excel-Export" type="button">&nbsp;Download from Employee</button>
                            </div>

                            <div class="col-12 col-sm-6 col-md-6">
                                <label>&nbsp;</label>
                                <button id="btnExportFormOpening" class="sym-btn-Excel-Export" type="button" style="margin-left: auto; display: block">&nbsp;Download from Opening</button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    $(function () {
        InitDropdownsCommon();
        valiDation('EmployeePFOpeningImportExportPage');
    });

    $('#btnExportFormEmployee').click(function () {
        if (!validateRequiredFields("#EmployeePFOpeningImportExportPage", ".exportRequired")) {
            return false;
        }

        //var path = window.location.href;
        //var fid = $("#FiscalPeriodDetailId").val();
        var ProjectId = $("#ProjectId").val();
        var DepartmentId = $("#DepartmentId").val();
        var SectionId = $("#SectionId").val();
        var DesignationId = $("#DesignationId").val();
        var CodeF = $("#CodeF").val();
        var CodeT = $("#CodeT").val();
        //var ETId = $("#EarningTypeId").val();
        var Orderby = $("#Orderby").val();

       
        if (Orderby == "") {
            ShowResult('Fail', "Please Select Order By ");
            return false;
        }

        window.location = '@Url.Action("DownloadExcel_Employee", "EmployeePFOpeinig")' + '?ProjectId=' + ProjectId
                  + '&DepartmentId=' + DepartmentId
                  + '&SectionId=' + SectionId
                  + '&DesignationId=' + DesignationId
                  + '&CodeF=' + CodeF
                  + '&CodeT=' + CodeT                  
                  + '&Orderby=' + Orderby
    });

    $('#btnExportFormOpening').click(function () {
        if (!validateRequiredFields("#EmployeePFOpeningImportExportPage", ".exportRequired")) {
            return false;
        }

        //var path = window.location.href;
        //var fid = $("#FiscalPeriodDetailId").val();
        var ProjectId = $("#ProjectId").val();
        var DepartmentId = $("#DepartmentId").val();
        var SectionId = $("#SectionId").val();
        var DesignationId = $("#DesignationId").val();
        var CodeF = $("#CodeF").val();
        var CodeT = $("#CodeT").val();
        //var ETId = $("#EarningTypeId").val();
        var Orderby = $("#Orderby").val();


        if (Orderby == "") {
            ShowResult('Fail', "Please Select Order By ");
            return false;
        }

        window.location = '@Url.Action("DownloadExcel_Opening", "EmployeePFOpeinig")' + '?ProjectId=' + ProjectId
                  + '&DepartmentId=' + DepartmentId
                  + '&SectionId=' + SectionId
                  + '&DesignationId=' + DesignationId
                  + '&CodeF=' + CodeF
                  + '&CodeT=' + CodeT
                  + '&Orderby=' + Orderby
    });

</script>

<script>

    function ImportExcle() {
        if (!validateRequiredFields("#EmployeePFOpeningImportExportPage", ".importRequired")) {
            return false;
        }

        pageSubmit('ImportEmployeePFOpeinigExcel');

    }

</script>


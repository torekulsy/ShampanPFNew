@model SymViewModel.PF.PFReportVM
@using UIHelper.MVC
@{

    ViewBag.Title = "Create";
    ViewBag.Location = "Create";
}



@using (Html.BeginForm("PFContributionReport", "PFDetail", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmVAT6_3", @target = "_blank" }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PFHeaderId)
    @*@Html.HiddenFor(model => model.Operation)*@
    <div class="">
        <div class="EnumEEHead">
            <div class="row mt-2">
                <label class="col-sm-3">
                    @*@Html.LabelFor(model => model.GroupName)*@
                    <label>Code</label>
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.Code, new { @placeholder = "Code", @class = " form-control" })
                </div>
            </div>

            <div class="row mt-2">
                <label class="col-sm-3">
                    @Html.LabelFor(model => model.DateFrom)
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.DateFrom, new { @placeholder = "Date From", @class = "customDatePicker form-control" })
                    @Html.ValidationMessageFor(model => model.DateFrom)
                </div>
            </div>

            <div class="row mt-2">
                <label class="col-sm-3">
                    @Html.LabelFor(model => model.DateTo)
                </label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.DateTo, new { @placeholder = "Date To", @class = "customDatePicker form-control" })
                    @Html.ValidationMessageFor(model => model.DateTo)
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-sm-12">
                    <div class="reportModalbtn">
                        @*<button type="button" title="Report Preview" onclick="pageSubmit('frmCOAGroup');" class="sym-btn-save">&nbsp;Preview</button>*@
                        <button type="button" title="Click for Report" data-url="/@ViewBag.TransType/PFDetail/PFContributionReport" onclick="reportData(this);" id="" class="sym-btn-report">&nbsp;Preview</button>
                        <button type="button" title="Clear the Entries" id="Clear" class="sym-btn-clear" style="margin: auto; display: block">&nbsp;Clear</button>
                        <button type="button" title="Cancel Data" class=" btncancel sym-btn-cancel">&nbsp;Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script>
    $(function () {
        InitDropDowns();
        InitDateTimePickers();
        $("#Clear").on('click', function () {
            $("#Code").val("");
            $("#Id").val("");
            $("#PFHeaderId").val("");
            $("#DateFrom").val("");
            $("#DateTo").val("");

        });
    });

    function reportData(sender) {
        $("#frmVAT6_3").submit();
    }

</script>

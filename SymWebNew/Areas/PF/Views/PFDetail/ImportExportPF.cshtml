<script>
    $(function () {
        InitDropdownsCommon();
        loadFiscalPeriods();

        $('#FiscalYear').on('change.pfImportExport', function () {
            loadFiscalPeriods();
        });

        valiDation('ImportExportPFPage');
    });

    function loadFiscalPeriods() {
        var fiscalYear = $('#FiscalYear').val();
        var $fiscalPeriod = $('#FiscalPeriodDetailId');

        $fiscalPeriod.html("<option value=''>Select</option>");

        if (!fiscalYear) {
            return;
        }

        $.getJSON('/Config/DropDown/DropDownPeriodByFYear', { year: fiscalYear })
            .done(function (data) {
                var options = "<option value=''>Select</option>";

                $.each(data, function (index, item) {
                    options += '<option value="' + item.Value + '">' + item.Text + '</option>';
                });

                $fiscalPeriod.html(options).trigger('change');
            })
            .fail(function () {
                ShowResult('Fail', 'Fiscal Period data could not be loaded.');
            });
    }

    $('#btnSearch').click(function () {
        var requiredDownloadFields = '#FiscalYear, #FiscalPeriodDetailId, #ProjectId, #Orderby';
        if (!validateRequiredFields("#ImportExportPFPage", requiredDownloadFields)) {
            return false;
        }

        var downloadParameters = {
            fid: $('#FiscalPeriodDetailId').val(),
            ProjectId: $('#ProjectId').val() || '',
            DepartmentId: $('#DepartmentId').val() || '',
            SectionId: $('#SectionId').val() || '',
            DesignationId: $('#DesignationId').val() || '',
            CodeF: $('#CodeF').val() || '',
            CodeT: $('#CodeT').val() || '',
            ETId: $('#EarningTypeId').val() || 0,
            Orderby: $('#Orderby').val() || ''
        };

        window.location.href = '@Url.Action("DownloadPFDetailsExcel", "PFDetail")' + '?' + $.param(downloadParameters);
        return false;
    });
</script>

<script>

    function ImportOtherEarning() {
        debugger;
        var requiredImportFields = '#FiscalYear, #FiscalPeriodDetailId, #ProjectId, #FileUpload';
        if (!validateRequiredFields("#ImportExportPFPage", requiredImportFields)) {
            return false;
        }

        var FiscalYearDetailId = $('#FiscalPeriodDetailId').val();
        var ProjectId = $('#ProjectId').val();

        //if (FiscalYearDetailId == "") {
        //    ShowResult('Fail', "Please Select Fiscal year");
        //    return;
        //}
        //if (ProjectId == "") {
        //    ShowResult('Fail', "Please Select Project Id");
        //    return;
        //}
        $('#FYDId').val(FiscalYearDetailId);
        $('#PId').val(ProjectId);


        

        ////console.log(FiscalYearDetailId); FYDId

        var url = "/Common/FiscalYear/FiscalPeriodLockCheck?FiscalYearDetailId=" + FiscalYearDetailId;

        $.ajax({
            url: url
               , type: 'Post'
               , traditional: true
               , beforeSend: function () { $(".loading").show(); }
               , success: ImportData
            , complete: function () { $(".loading").fadeOut(200).hide("slow") }
        });
        
    }

    function ImportData(result) {
        debugger;
        var results = result.split("~");

        if (results[0].toLowerCase() == 'true') {

            ShowResult("Fail", results[1]);

        }
        else {

            pageSubmit('ImportPFDetailExcel');

        }

    }


</script>

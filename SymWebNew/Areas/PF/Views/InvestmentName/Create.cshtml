<script>
    $('.AddRow:not(.AddRowInited)').on("click", function () {
        var container = $(this).attr('data-container');
        AddRow(container);
        return false;
    }).addClass("AddRowInited");

    function validatePolicyValues(fromText, toText, interestRateText, existingPeriods) {
        fromText = $.trim(fromText || "");
        toText = $.trim(toText || "");
        interestRateText = $.trim(interestRateText || "");

        if (fromText === "") {
            return { error: "Please enter Accrued From month." };
        }
        if (toText === "") {
            return { error: "Please enter To Month." };
        }
        if (interestRateText === "") {
            return { error: "Please enter Interest Rate." };
        }

        var fromMonth = Number(fromText);
        var toMonth = Number(toText);
        var interestRate = Number(interestRateText);

        if (!isFinite(fromMonth) || Math.floor(fromMonth) !== fromMonth || fromMonth < 1 || fromMonth > 12) {
            return { error: "Accrued From month must be a whole number between 1 and 12." };
        }
        if (!isFinite(toMonth) || Math.floor(toMonth) !== toMonth || toMonth < 1 || toMonth > 12) {
            return { error: "To Month must be a whole number between 1 and 12." };
        }
        if (fromMonth > toMonth) {
            return { error: "Accrued From cannot be greater than To Month." };
        }
        if (!isFinite(interestRate)) {
            return { error: "Interest Rate must be a valid number." };
        }
        if (interestRate < 0) {
            return { error: "Interest Rate cannot be negative." };
        }

        for (var index = 0; index < existingPeriods.length; index++) {
            var period = existingPeriods[index];
            if (fromMonth <= period.toMonth && period.fromMonth <= toMonth) {
                return { error: "This policy period duplicates or overlaps an existing period." };
            }
        }

        return {
            error: null,
            fromMonth: fromMonth,
            toMonth: toMonth,
            interestRate: interestRate
        };
    }

    function getPolicyPeriods() {
        var periods = [];

        $("#detail #editorItemRows4 .row.details").each(function () {
            var fromMonth = Number($(this).find(".dFromMonth").val());
            var toMonth = Number($(this).find(".dToMonth").val());

            if (isFinite(fromMonth) && isFinite(toMonth)) {
                periods.push({ fromMonth: fromMonth, toMonth: toMonth });
            }
        });

        return periods;
    }

    function validateInterestPolicyRows() {
        var periods = [];
        var errorMessage = null;

        $("#detail #editorItemRows4 .row.details").each(function (index) {
            var validation = validatePolicyValues(
                $(this).find(".dFromMonth").val(),
                $(this).find(".dToMonth").val(),
                $(this).find(".dInterestRate").val(),
                periods
            );

            if (validation.error) {
                errorMessage = "Interest Policy row " + (index + 1) + ": " + validation.error;
                return false;
            }

            periods.push({ fromMonth: validation.fromMonth, toMonth: validation.toMonth });
        });

        return errorMessage;
    }

    function AddRow(container) {
        var url = '/@ViewBag.TransType/InvestmentName/BlankItem';
        var oParam = { "FromMonth": "", "ToMonth": "", "InterestRate": "", "Remarks": "", };

        var fromMonth = $('.drFromMonth').val();
        var toMonth = $('.drToMonth').val();
        var interestRate = $(".crInterestRate").val();
        var remarks = $(".drRemarks").val();
        var validation = validatePolicyValues(fromMonth, toMonth, interestRate, getPolicyPeriods());

        if (validation.error) {
            ShowResult("Fail", validation.error);
            return;
        }

        oParam.FromMonth = validation.fromMonth;
        oParam.ToMonth = validation.toMonth;
        oParam.InterestRate = validation.interestRate;
        oParam.Remarks = remarks;

        $.ajax({
            url: url,
            //type: 'POST',
            cache: false,
            data: oParam,
            success: function (html) {
                $("#" + container).append(html);
            }
        });
        $('#detail').show();
        $(".drFromMonth").val("");
        $(".drToMonth").val("");
        $(".crInterestRate").val("");
        $(".drRemarks").val("");
    }
    function EditProduct(sender) {

        $(".drFromMonth").val($(sender).parents().parents().find('.dFromMonth').val());
        $(".drToMonth").val($(sender).parents().parents().find('.dToMonth').val());
        $(".crInterestRate").val($(sender).parents().parents().find('.dInterestRate').val());
        $(".drRemarks").val($(sender).parents().parents().find('.dRemarks').val());
        $(sender).parents("div.row:first").remove();
        //ShowHide();
    }

    function RemoveProduct(sender) {
        Ask("Are you sure you want to delete this data?", function () {
            $(sender).parents("div.row:first").remove();
            //ShowHide();
        });
    }

    function ShowHide() {
        //var accName = $('.dInterestRate').val();
        //if (accName == null) {
        //    $('#detail').hide();
        //}
        //else {
        //    $('#detail').show();
        //}
    }



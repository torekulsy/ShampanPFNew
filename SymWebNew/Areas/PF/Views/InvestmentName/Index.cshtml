<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Investment List</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>


<div class="thinbox">
    <div class="th_thinbox">
        <p>Investment List</p>
    </div>

    <div class="custom-top">
        <div id="mainBtnAll">
            <button type="button" title="Add New Investment Name" data-url="/@ViewBag.TransType/InvestmentName/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
            <button type="button" data-url="/@ViewBag.TransType/InvestmentName/DownloadExcel" onclick="GoTo(this)" id="" title="Click to Download the Report" class="sym-btn-Excel-Export">&nbsp;Download</button>
            @* <button type="button" title="Delete Investment Name" data-url="/@ViewBag.TransType/InvestmentName/Delete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>*@
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>

    <table id="myDataTable" class="display">
        <thead>
            <tr>
                
                <th class="center">Action</th>
                <th class="center">Investment No</th>
                <th class="center">Name</th>
                <th class="center">Address </th>
                <th class="center">Remarks</th>
                
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>
<div class="card mt-3">
    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New Investment Name" data-url="/@ViewBag.TransType/InvestmentName/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
            <button type="button" data-url="/@ViewBag.TransType/InvestmentName/DownloadExcel" onclick="GoTo(this)" id="" title="Click to Download the Report" class="sym-btn-Excel-Export">&nbsp;Download</button>
            @*<button type="button" title="Delete Investment Name" data-url="/@ViewBag.TransType/InvestmentName/Delete" onclick="deletedData(this, 'myDataTable');" id="" class="sym-btn-remove">&nbsp;Delete</button>*@
        </div>
    </div>
</div>

<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/@ViewBag.TransType/InvestmentName/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "5%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    return ' '
                                        + '&nbsp; <a id=""  title="Click on for Edit"  style="text-decoration:none;"   href=\"/@ViewBag.TransType/InvestmentName/Edit/' + oObj.aData[0] + '\" class=" innerListLink sym-btn-edit-row"></a>'
                                       @*+ '&nbsp; <a title="Click on for Accrued"  href="/@ViewBag.TransType/InvestmentName/AccruedProcessView?InvestmentNameId=' + oObj.aData[0] + '\" class="sym-btn-add-row lnkEdit"></a>'*@
                                      + '&nbsp; <a title="Click on for Report" data-url="/@ViewBag.TransType/InvestmentName/ReportView"  onclick=reportData(this); data-Id="' + oObj.aData[0] + '\" class="sym-btn-report-row"></a>'


                                    ;
                                }
                            }
                            , { "sName": "Code", "sWidth": "10%" }
                            , { "sName": "Name", "sWidth": "10%" }
                            , { "sName": "Address", "sWidth": "10%" }
                            , { "sName": "Remarks", "sWidth": "10%" }
                           

                            

            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>
<script>

    function reportData(sender) {
        var url = $(sender).attr('data-url');
        var code = $(sender).attr('data-Id');
        rptObj = new Object();
        rptObj.id = code;


        var rptParam = $.param(rptObj);
        url = url + "?" + rptParam;
        var win = window.open(url, '_blank');
    }
</script>

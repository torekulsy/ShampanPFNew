@model SymViewModel.PF.PFSettlementVM
@using UIHelper.MVC
@using UIHelper.MVC
<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Resign Employee</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>
<div class="thinbox">
    <div class="th_thinbox">
        <p>Resign Employee List</p>
    </div>

    <div class="custom-top">
        <div id="mainBtnAll">
           @using (Html.BeginForm("Create", "PFSettlement", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmPFSettlementCreate" }))
{
    @Html.HiddenFor(model => model.EmployeeId)

    <div class="row">
        <div class="col-12">
            <div class="editor-label">
                @Html.LabelFor(model => model.SettlementDate)
            </div>
            <div class="editor-field">
                @Html.TextBoxFor(model => model.SettlementDate, new { @placeholder = "Settlement Date", @class = " cSettlementDate required customDatePicker form-control" })
            </div>
        </div>
    </div>
}
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>

    <table id="myDataTable" class="display">
        <thead>
            <tr>
                <th>Action</th>
                <th>Code</th>
                <th>Name</th>
                <th>Designation</th>
                <th>Department</th>
                <th>Resign Date</th>

            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
    </div>
    <div class="headrow">
    </div>
    <script language="javascript" type="text/javascript">
        $(document).ready(function () {
            SelectAllForDelete();
            $.datepicker.regional[""].dateFormat = 'dd/M/y';
            $.datepicker.setDefaults($.datepicker.regional['']);
            var oTable = $('#myDataTable').dataTable({
                "bServerSide": true,
                "sAjaxSource": "/@ViewBag.TransType/PFSettlement/_indexResignEmployee",
                "bProcessing": true,
                "aLengthMenu": tablelength(),
                "bJqueryUI": true,
                "bAutoWidth": false,
                "bPaginate": true,
                "sPaginationType": "full_numbers",
                "iDisplayLength": 10,
                "oLanguage": {
                    "oPaginate": {
                        "sPrevious": '<i class="fa fa-angle-left"></i>',
                        "sNext": '<i class="fa fa-angle-right"></i>'
                    },
                    "sSearch": ""
                },

                "fnDrawCallback": function () {
                    $('.dataTables_filter input')
                        .attr('placeholder', 'Search...');
                },
                "aoColumns": [
                                {
                                    "sName": "EmployeeId",
                                    "bSearchable": false,
                                    "bSortable": false,
                                    "sWidth": "2%",
                                    "sClass": "center",
                                    "fnRender": function (oObj) {

                                        return ''
                                        + '&nbsp; <a title="Click on for Process" style="text-decoration:none;" data-url="/@ViewBag.TransType/PFSettlement/Create" onclick="ProcessData(this, \'' + oObj.aData[0] + '\');"  class="sym-btn-save-row"></a>'
                                        ////;
                                    }
                                }
                                , { "sName": "Code", "sWidth": "10%" }
                                , { "sName": "EmpName", "sWidth": "10%" }
                                , { "sName": "Designation", "sWidth": "10%" }
                                , { "sName": "Department", "sWidth": "10%" }
                                , { "sName": "EmpResignDate", "sWidth": "10%" }

                ]
            });
            $("#footer-length").append($(".dataTables_length"));
            $("#footer-info").append($(".dataTables_info"));
            $("#footer-pagination").append($(".dataTables_paginate"));
            $("#dataTables_filter").append($(".dataTables_filter"));

            $(document).on("click", ".mobile-search-toggle", function (e) {
                e.stopPropagation();
                $("#dataTables_filter").slideToggle(150);
            });
        });
    </script>


    <script>
        $(function () {
            valiDation("frmPFSettlementCreate");
        });


        function ProcessData(sender, id) {

            Ask("Are you sure to Settlement!", function () {

                $("#EmployeeId").val(id);
                pageSubmit('frmPFSettlementCreate')

            }, function () { })
        }
    </script>

@model SymViewModel.PF.PFBankDepositVM
@using UIHelper.MVC
<div class="card">
    <div class="card-header p-3">
        <div class="th_thinbox_top">
            <p>Return On Bank Interest</p>
            <div class="breadcrumb-container">
                <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
            </div>
        </div>
    </div>
</div>

<div class="thinbox">
    <div class="th_thinbox">
        <p>Return On Bank Interest List</p>
    </div>
    <div class="custom-top">
        <div id="mainBtnAll">
            <button type="button" title="Add New Return On Bank Interest" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
            <button type="button" title="Post Checked Issue" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Post" onclick="postedData(this, 'myDataTable');" id="" class="sym-btn-post" style="display: none;">&nbsp;Post</button>
        </div>
        <div class="table-search">
            <div class="mobile-search-toggle">
                <i class="fa fa-search"></i>
            </div>
            <div id="dataTables_filter"></div>
        </div>

    </div>
    <table id="myDataTable" class="display">
        <thead>
            <tr>
               
                <th class="center">Action</th>
                <th class="center">Code</th>
                <th class="center">Bank Branch Name</th>
                <th class="center">RO Bank Interest Date</th>
                <th class="center">Total Interest Value</th>
                <th class="center">Post Status</th>


                @*
                    BankBranchName
                    ROBIDate
                    ROBIRate
                    TotalInterestValue
                    Post
                *@
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <div class="custom-footer">
        <div id="footer-length"></div>
        <div id="footer-info"></div>
        <div id="footer-pagination"></div>
    </div>
</div>
<div class="card mt-3">
    <div class="card-header p-3">
        <div class="">
            <button type="button" title="Add New Return On Bank Interest" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Create" onclick="GoTo(this)" id="" class=" sym-btn-add ">&nbsp;New</button>
            <button type="button" title="Post Checked Issue" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Post" onclick="postedData(this, 'myDataTable');" id="" class="sym-btn-post" style="display: none;">&nbsp;Post</button>
        </div>
    </div>
</div>

@using (Html.BeginForm("Create", "PFBankDeposit", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmPFBankDepositGet" }))
{
    @Html.HiddenFor(model => model.TransactionType)
    @Html.HiddenFor(model => model.ReferenceId)

}


<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/@ViewBag.TransType/ReturnOnBankInterest/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "4%",
                                "sClass": "center",
                                "fnRender": function (oObj) {

                                    if(oObj.aData[5] == "Posted")
                                    {
                                        return '  '
                                        + ' <a id="lnkEdit1"  title="Click on for Edit" style="text-decoration:none;"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/Edit/' + oObj.aData[0] + '\" class=" innerListLink sym-btn-edit-row"></a>'
                                        + '<a title="Click on for Post" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Post"  onclick=btnPostNew(this); data-Id="' + oObj.aData[0] + '\" class="sym-btn-reject-row" style="opacity:0.45;pointer-events:none;cursor:default;"></a>'
                                        //+ '&nbsp; <a id=""  title="Click to view Transaction Report" target="_blank"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/ROB_GLTransactionReport?id=' + oObj.aData[0] + '\" class="  sym-btn-report-row"></a>'
                                        @*+ ' <a id="lnkEdit1"  title="Click on for Report" style="text-decoration:none;"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/reportVeiw/' + oObj.aData[0] + '\" class=" linkReport sym-btn-report-row"></a>'*@
                                         + ' <a title="Click on for Report" href="/@ViewBag.TransType/ReturnOnBankInterest/ReportView?id='+ oObj.aData[0]+ '" class="sym-btn-report-row"></a>'

                                    + ' <a title="Click on for Journal" target="_blank"  href="/@ViewBag.TransType/Journal/Create?JournalType=3' + '&TransactionForm=BankInterest(ROBI)' + '&TransactionId=' + oObj.aData[0] + '\" class="sym-btn-bank-row"></a>'
                                    }
                                  else
                                     {
                                        return '  '
                                     + '<a id="lnkEdit1"  title="Click on for Edit" style="text-decoration:none;"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/Edit/' + oObj.aData[0] + '\" class=" innerListLink sym-btn-edit-row"></a>'
                                     + '<a title="Click on for Post" data-url="/@ViewBag.TransType/ReturnOnBankInterest/Post"  onclick=btnPostNew(this); data-Id="' + oObj.aData[0] + '\" class="sym-btn-post-row"></a>'
                                     //+ '&nbsp; <a id=""  title="Click to view Transaction Report" target="_blank"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/ROB_GLTransactionReport?id=' + oObj.aData[0] + '\" class="  sym-btn-report-row"></a>'
                                        @*+ '<a id="lnkEdit1"  title="Click on for Report" style="text-decoration:none;"    href=\"/@ViewBag.TransType/ReturnOnBankInterest/reportVeiw/' + oObj.aData[0] + '\" class=" linkReport sym-btn-report-row"></a>'*@
                                        + ' <a title="Click on for Report" href="/@ViewBag.TransType/ReturnOnBankInterest/ReportView?id='+ oObj.aData[0]+ '" class="sym-btn-report-row"></a>'

                                 //+ '&nbsp; <a title="Click on for Journal" target="_blank"  href="/@ViewBag.TransType/Journal/Create?JournalType=3' + '&TransactionForm=BankInterest(ROBI)' + '&TransactionId=' + oObj.aData[0] + '\" class="sym-btn-bank-row"></a>'
                                    }
                                    ;
                                }
                            }
                            , { "sName": "Code", "sWidth": "10%" }
                            , { "sName": "BankBranchName", "sWidth": "10%" }
                            , { "sName": "TransactionDate", "sWidth": "10%" }
                            , {
                                "sName": "TotalValue", "sWidth": "10%", "sClass": "right", "fnRender": function (oObj) {
                                    return formatNumberWithCommas(oObj.aData[4]);
                                }
                            }
                            , { "sName": "Post", "sWidth": "10%" }



            ]
        });
        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });
</script>

<script>
    function btnPostNew(sender) {

        var Id = $(sender).attr("data-Id");

        var getURL = "/@ViewBag.TransType/ReturnOnBankInterest/GetReturnOnBankInterest" + "?" + "id=" + Id;

        $.getJSON(getURL, function (vm) {

            if (vm.Post) {
                ShowResult("Fail", "Data Already Posted!");
                return true;
            }
            else {
                var url = $(sender).attr("data-url") + "?ids=" + Id + '~';
                var questionMSG = "Are you sure to Post Data!";
                singleOperation(questionMSG, url);
            }

        });

    }

    function btnDeleteNew(sender) {

        var Id = $(sender).attr("data-Id");

        var getURL = "/@ViewBag.TransType/ReturnOnBankInterest/GetReturnOnBankInterest" + "?" + "id=" + Id;

        $.getJSON(getURL, function (vm) {

            if (vm.Post) {
                ShowResult("Fail", "Data Already Posted! Can't Be Deleted!");
                return true;
            }
            else {
                var url = $(sender).attr("data-url") + "?ids=" + Id + '~';
                var questionMSG = "Are you sure you want to delete this data?";
                singleOperation(questionMSG, url);
            }

        });

    }

</script>

<script>
    function btnBankDeposit(sender) {
        var id = $(sender).attr("data-Id");


        var getURL = "/@ViewBag.TransType/ReturnOnBankInterest/GetReturnOnBankInterest" + "?" + "id=" + id;

        $.getJSON(getURL, function (vm) {

            if (!vm.Post) {
                ShowResult("Fail", "Do Post before Bank Deposit!");
                return;
            }

            if (vm.IsBankDeposited) {
                ShowResult("Fail", "Already Deposited to Bank!");
                return;
            }


            $("#ReferenceId").val(id);
            $("#TransactionType").val("ReturnOnBankInterest");

            $("#frmPFBankDepositGet").submit();

        });



    }
    function formatNumberWithCommas(value) {
        if (value == null || value === '') return '';
        value = parseFloat(value).toFixed(2);
        var parts = value.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts[0] + '.' + parts[1];
    }

</script>

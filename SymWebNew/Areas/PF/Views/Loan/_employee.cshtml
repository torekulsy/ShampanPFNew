@model IEnumerable<SymViewModel.HRM.EmployeeInfoVM>
@{
    ViewBag.Title = "Employee List";
    ViewBag.Location = "Employee List";
}
<!DOCTYPE html>
<html>
<head>

</head>
<body>
    <div class="card">
        <div class="card-header p-3">
            <div class="th_thinbox_top">
                <p>Employee Loan</p>
                <div class="breadcrumb-container">
                    <ol class="breadcrumb" id="dynamicBreadcrumb"></ol>
                </div>
            </div>
        </div>
    </div>
    
    <div class="thinbox">
        <div class="th_thinbox">
            <p>Employee List for Loan</p>
        </div>
        <div class="custom-top">
            <div id="mainBtnAll">
                <p>&nbsp;</p>
            </div>
            <div class="table-search">
                <div class="mobile-search-toggle">
                    <i class="fa fa-search"></i>
                </div>
                <div id="dataTables_filter"></div>
            </div>

        </div>
        <div id="container">
            <div id="demo">
                <table id="myDataTable" class="display">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>@Session["DepartmentLabel"]</th>
                            <th>Designation</th>
                            <th>Join Date</th>
                        </tr>

                        <tr>
                            <th class="center">Actions</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>@Session["DepartmentLabel"]</th>
                            <th>Designation</th>
                            <th>Join Date</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>
        </div>
        <div class="custom-footer">
            <div id="footer-length"></div>
            <div id="footer-info"></div>
            <div id="footer-pagination"></div>
        </div>
    </div>

    @*         <div class="headrow">
        </div>*@
</body>
</html>


<script>

    $(document).ready(function () {
        //InitCustomDialog();

        if ('@Session["result"]' != "") {
            var tt = '@Session["result"]';
            var tt1 = tt.split("~");
            // $(".dialog-alert").dialog('open');
            $("#dialog-msg").append('' + tt1[1]);
            $(".ui-dialog").addClass('' + tt1[0]);
        }
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/PF/Loan/_EmployeeInfoForLoan",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "bPaginate": true,
            "sPaginationType": "full_numbers",
            "iDisplayLength": 10,
            "oLanguage": {
                "oPaginate": {
                    "sPrevious": '<i class="fa fa-angle-left"></i>',
                    "sNext": '<i class="fa fa-angle-right"></i>'
                },
                "sSearch": ""
            },

            "fnDrawCallback": function () {
                $('.dataTables_filter input')
                    .attr('placeholder', 'Search...');
            },
            "aoColumns": [
         {
             "sName": "Id",
             "bSearchable": false,
             "bSortable": false,
             "sWidth": "5%",
             "sClass": "center",
             "fnRender": function (oObj) {

                 return '   <a id="lnkEdit1"  title="Click for Entry" style="text-decoration:none;"  href="/PF/Loan/Create?employeeId=' + oObj.aData[0] + '\" class="btn btn-warning btn-xs "><i class="fa fa-list-ul"></i></a>' //+
                 ;
             }
         }
                                , { "sName": "Code", "sWidth": "15%" }
                                , { "sName": "EmpName", "sWidth": "20%" }
                                , { "sName": "Department", "sWidth": "15%" }
                                , { "sName": "Designation", "sWidth": "15%" }
                                , { "sName": "JoinDate", "sWidth": "20%" }

        //Code
        //EmpName
        //Department
        //Designation
        //JoinDate
            ]
        });
        oTable.columnFilter({
            sPlaceHolder: "head:after",
            aoColumns: [{ type: "checkbox", "sClass": "chkAll" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "text" }
                           , { type: "date-range" }
            ]

        });

        $("#footer-length").append($(".dataTables_length"));
        $("#footer-info").append($(".dataTables_info"));
        $("#footer-pagination").append($(".dataTables_paginate"));
        $("#dataTables_filter").append($(".dataTables_filter"));

        $(document).on("click", ".mobile-search-toggle", function (e) {
            e.stopPropagation();
            $("#dataTables_filter").slideToggle(150);
        });
    });

</script>

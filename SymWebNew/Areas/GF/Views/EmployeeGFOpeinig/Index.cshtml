@using UIHelper.MVC
@{
    ViewBag.Title = "Index";
}
<div class="erp-page-wrapper">
    <div class="erp-action-bar">
        <div class="erp-action-btns">
            <button type="button" title="Add New Employee GF Opening" data-url="/@ViewBag.TransType/EmployeeGFOpeinig/SingleEmployeeGFOpeinigEdit" onclick="GoTo(this)" id="" class="sym-btn-add btn-erp-add">&nbsp;New</button>
            <button type="button" title="Import/Export" id="" class="sym-btn-ExportImport btn-erp-export" data-url="/@ViewBag.TransType/EmployeeGFOpeinig/ImportEmployeeGFOpeinig" onclick="GoTo(this)">&nbsp;Import/Export</button>
        </div>
        <div class="erp-breadcrumb">
            <label class="pull-right">Employee GF Opening &gt; Index</label>
        </div>
    </div>
    <div class="card erp-card">
        <div class="card-header erp-card-header">
            <p><i class="fa fa-folder-open-o"></i> Employee GF Opening List</p>
        </div>
        <div class="card-body erp-card-body" style="padding: 16px 20px;">
            <div id="container">
                <table id="myDataTable" class="display">
                    <thead>
                        <tr>
                            <th class="center">Actions</th>
                            <th class="center">Code</th>
                            <th class="center">Name</th>
                            <th class="center">Employer Contribution</th>
                            <th class="center">Employer Profit</th>
                            <th class="center">Date</th>
                            <th class="center">Post</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        SelectAllForDelete();
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/@ViewBag.TransType/EmployeeGFOpeinig/_index",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "aoColumns": [
                 {
                     "sName": "Id",
                     "bSearchable": false,
                     "bSortable": false,
                     "sWidth": "12%",
                     "sClass": "center",
                     "fnRender": function (oObj) {
                         return '  &nbsp;  <a title="Click on for Edit" id="lnkEdit1" style="text-decoration:none;" Onclick="otherearningEdit(this);"  class=" sym-btn-edit-row"  data-Id="' + oObj.aData[0] + '"></a>'
                             + '&nbsp; <a title="Click on for Post" style="text-decoration:none;" data-url="/@ViewBag.TransType/EmployeeGFOpeinig/MultiplePost" onclick="postedData(this, myDataTable,\'' + oObj.aData[0] + '\');"  class="sym-btn-post-row"></a>'
                         ;
                     }
                 }
                 , { "sName": "Code", "sWidth": "10%" }
                 , { "sName": "Name", "sWidth": "14%" }
                 , { "sName": "EmployerContribution", "sWidth": "10%", "sType": "numeric" }
                 , { "sName": "EmployerProfit", "sWidth": "10%", "sType": "numeric" }
                 , { "sName": "OpeningDate", "sClass": "center", "sWidth": "10%" }
                 , { "sName": "Post", "sClass": "right", "sWidth": "18%" }
            ]
        });
    });
    function otherearningEdit(sender) {
        window.location = "/@ViewBag.TransType/EmployeeGFOpeinig/SingleEmployeeGFOpeinigEdit?PFOpeinigId=" + $(sender).attr('data-Id');
    }
</script>

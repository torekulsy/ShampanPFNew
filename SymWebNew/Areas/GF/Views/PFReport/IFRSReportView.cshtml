@model SymViewModel.PF.PFReportVM

@using UIHelper.MVC
@using SymOrdinary
@using System.Threading;
@{
    ShampanIdentity identity = null;
    try
    {
        identity = (ShampanIdentity)Thread.CurrentPrincipal.Identity;
    }
    catch (Exception)
    {
        Response.Redirect("/Home/Index");
        return;
    }
}

@{
    ViewBag.Title = "Index";
    string CompanyName = System.Configuration.ConfigurationManager.AppSettings["CompanyName"];
    string reportType = (Model.ReportType ?? "").ToUpper();
    string reportTitle = "Financial Report";
    if (reportType == "BS") { reportTitle = "Balance Sheet Report"; }
    else if (reportType == "IS") { reportTitle = "Income Statement (P/L) Report"; }
    else if (reportType == "TB") { reportTitle = "Trial Balance Report"; }
    else if (reportType == "NC") { reportTitle = "Net Change Report"; }
    else if (reportType == "TB1") { reportTitle = "Trial Balance 2 Report"; }
}

@using (Html.BeginForm("IFRSReport", "PFReport", FormMethod.Post, new { enctype = "multipart/form-data", @Id = "frmFR", @target = "_blank" }))
{
    @Html.HiddenFor(model => model.ReportType)
    @Html.HiddenFor(model => model.TransType)

    <div class="thinbox">
        <div class="th_thinbox">
            <p><i class="fa fa-file-text-o"></i> @reportTitle</p>
        </div>

        <div class="EnumEEHead" style="padding: 20px 24px;">
            @if (reportType == "BS" || reportType == "IS" || reportType == "TB")
            {
                <div style="display: flex; align-items: flex-end; gap: 16px;">
                    <div style="padding-bottom: 6px; font-weight: 700; font-size: 13.5px; color: #334155; white-space: nowrap; min-width: 45px;">
                        <label style="margin: 0; font-weight: 700; font-size: 13.5px; color: #334155;">As of</label>
                    </div>
                    <div class="ep-form-group" style="flex: 1;">
                        <label class="ep-field-label">Year <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDown("FiscalYear", "/Config/DropDown/DropDownYear", new { @class = " fiscalyearCom required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group" style="flex: 1;">
                        <label class="ep-field-label">Month <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.MonthTo, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                        </div>
                    </div>
                </div>
            }
            else if (reportType == "NC")
            {
                <div style="display: flex; align-items: flex-end; gap: 16px;">
                    <div style="padding-bottom: 6px; font-weight: 700; font-size: 13.5px; color: #334155; white-space: nowrap; min-width: 45px;">
                        <label style="margin: 0; font-weight: 700; font-size: 13.5px; color: #334155;">As of</label>
                    </div>
                    <div class="ep-form-group" style="flex: 1;">
                        <label class="ep-field-label">Year <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDown("FiscalYear", "/Config/DropDown/DropDownYear", new { @class = " fiscalyearCom required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group" style="flex: 1;">
                        <label class="ep-field-label">Period From <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.MonthFrom, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group" style="flex: 1;">
                        <label class="ep-field-label">Period To <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.MonthTo, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                        </div>
                    </div>
                </div>
            }
            else if (reportType == "TB1")
            {
                if (CompanyName == "EGCB")
                {
                    <div style="display: flex; align-items: flex-end; gap: 16px;">
                        <div style="padding-bottom: 6px; font-weight: 700; font-size: 13.5px; color: #334155; white-space: nowrap; min-width: 45px;">
                            <label style="margin: 0; font-weight: 700; font-size: 13.5px; color: #334155;">As of</label>
                        </div>
                        <div class="ep-form-group" style="flex: 1;">
                            <label class="ep-field-label">Date From <span class="text-danger">*</span></label>
                            <div class="editor-field">
                                @Html.TextBoxFor(model => model.DateFrom, new { @placeholder = "Date From", @class = "required customDatePicker form-control" })
                                @Html.ValidationMessageFor(model => model.DateFrom)
                            </div>
                        </div>
                        <div class="ep-form-group" style="flex: 1;">
                            <label class="ep-field-label">Date To <span class="text-danger">*</span></label>
                            <div class="editor-field">
                                @Html.TextBoxFor(model => model.DateTo, new { @placeholder = "Date To", @class = "required customDatePicker form-control" })
                                @Html.ValidationMessageFor(model => model.DateTo)
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: flex-end; gap: 16px;">
                        <div style="padding-bottom: 6px; font-weight: 700; font-size: 13.5px; color: #334155; white-space: nowrap; min-width: 45px;">
                            <label style="margin: 0; font-weight: 700; font-size: 13.5px; color: #334155;">As of</label>
                        </div>
                        <div class="ep-form-group" style="flex: 1;">
                            <label class="ep-field-label">Year <span class="text-danger">*</span></label>
                            <div class="editor-field">
                                @Html.SimpleDropDown("FiscalYear", "/Config/DropDown/DropDownYear", new { @class = " fiscalyearCom required form-control selectDropdown" })
                            </div>
                        </div>
                        <div class="ep-form-group" style="flex: 1;">
                            <label class="ep-field-label">Period From <span class="text-danger">*</span></label>
                            <div class="editor-field">
                                @Html.SimpleDropDownFor(model => model.MonthFrom, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                            </div>
                        </div>
                        <div class="ep-form-group" style="flex: 1;">
                            <label class="ep-field-label">Period To <span class="text-danger">*</span></label>
                            <div class="editor-field">
                                @Html.SimpleDropDownFor(model => model.MonthTo, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ep-form-grid" style="grid-template-columns: repeat(2, 1fr); gap: 14px 18px;">
                    <div class="ep-form-group col-span-1">
                        <label class="ep-field-label">Fiscal Year From <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.YearFrom, "/Config/DropDown/DropDownYear", new { @class = " fiscalyearCom required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group col-span-1">
                        <label class="ep-field-label">Fiscal Period From <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.MonthFrom, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsCom required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group col-span-1">
                        <label class="ep-field-label">Fiscal Year To <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.YearTo, "/Config/DropDown/DropDownYear", new { @class = " fiscalyearTo required form-control selectDropdown" })
                        </div>
                    </div>
                    <div class="ep-form-group col-span-1">
                        <label class="ep-field-label">Fiscal Period To <span class="text-danger">*</span></label>
                        <div class="editor-field">
                            @Html.SimpleDropDownFor(model => model.MonthTo, "/Config/DropDown/DropDownPeriodByFYear?year=" + @Session["SessionYear"].ToString(), new { @class = " fpDetailsTo required form-control selectDropdown" })
                        </div>
                    </div>
                </div>
            }

            <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 15px; padding-top: 10px; border-top: 1px solid #f1f5f9;">
                <button type="button" title="Click for Report" onclick="reportData(this);" class="sym-btn-Excel-Export btn-erp-print">&nbsp;Preview</button>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        InitDropdownsCommon();
        InitDropDowns();
        InitDateTimePickers();
    });

    function reportData(sender) {
        var MonthTo = $("#MonthTo").val();
        $("#frmFR").submit();
    }
</script>



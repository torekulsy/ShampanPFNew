<div class="erp-page-wrapper">
    <div class="erp-action-bar">
        <div class="erp-action-btns">
            <button type="button" title="Go To Index" data-url="/GF/EmployeeSettlement" onclick="GoTo(this)" class="sym-btn-detail btn-erp-index">&nbsp;Index</button>
        </div>
        <div class="erp-breadcrumb">
            <label class="pull-right">Employee Settlement &gt; Left Employees</label>
        </div>
    </div>
    <div class="card erp-card">
        <div class="card-header erp-card-header">
            <p><i class="fa fa-users"></i> Employee List (Left Employees)</p>
        </div>
        <div class="card-body erp-card-body" style="padding: 16px 20px;">
            <table id="myDataTable" class="display">
                <thead>
                    <tr>
                        <th class="center">
                            <input type="checkbox" class="chkAll" />Select All
                        </th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>@Session["DepartmentLabel"]</th>
                        <th>Join Date</th>
                        <th>Left Date</th>
                        <th>Job Year</th>
                    </tr>
                    <tr>
                        <th style="text-align: center">Actions</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>@Session["DepartmentLabel"]</th>
                        <th>Join Date</th>
                        <th>Left Date</th>
                        <th>Job Year</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script language="javascript" type="text/javascript">
    $(function () {
        customToollip();
        InitDateTimePickers();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/GF/EmployeeSettlement/_indexLeftEmployee",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "12%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    return '  <a title="Click on for Details" style="text-decoration:none;"    href=\"/GF/EmployeeSettlement/Create?EmployeeId=' + oObj.aData[0] + '\"  class="sym-btn-detail-row"></a>';
                                }
                            }
                            , { "sName": "Code", "sWidth": "8%" }
                            , { "sName": "EmpName", "sWidth": "12%" }
                            , { "sName": "Designation", "sWidth": "12%" }
                            , { "sName": "Department ", "sWidth": "10%" }
                            , { "sName": "JoinDate", "sWidth": "18%" }
                            , { "sName": "LeftDate", "sWidth": "18%" }
                            , { "sName": "TotalJobDurationYear", "sWidth": "8%" }
            ]
        });

        oTable.columnFilter
            ({
                sPlaceHolder: "head:after",
                aoColumns:
                    [
                        { type: "checkbox", "sClass": "chkAll" }
                        , { type: "text" }
                        , { type: "text" }
                        , { type: "text" }
                        , { type: "text" }
                        , { type: "date-range" }
                        , { type: "date-range" }
                    ]
            });
    });
</script>


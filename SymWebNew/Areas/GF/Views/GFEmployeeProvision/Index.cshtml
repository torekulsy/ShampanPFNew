<div class="erp-page-wrapper">
    <div class="erp-action-bar">
        <div class="erp-action-btns">
            <button type="button" title="Index" data-url="/GF/GFEmployeeProvision/IndexFiscalPeriod" onclick="GoTo(this)" id="" class="sym-btn-detail btn-erp-index btn-green">&nbsp;Index</button>
            <button type="button" title="Add New GF Employee Provision" data-url="/GF/GFEmployeeProvision/Process" onclick="GoTo(this)" id="" class="sym-btn-add btn-erp-add">&nbsp;New</button>
            <button type="button" title="Click to view GL Transaction Report" onclick="window.open('/GF/GFEmployeeProvision/GFEmployeeProvisionsReport?id=@ViewBag.gfHeaderId')" id="" class="sym-btn-report btn-erp-print">&nbsp;Report</button>
            <button type="button" title="Click to view GL Transaction Report" onclick="window.open('/GF/GFEmployeeProvision/GFEmployeeProvisionsDownload?id=@ViewBag.gfHeaderId')" id="" class="sym-btn-Excel-Export btn-erp-export">&nbsp;Download</button>
            <button type="button" title="Click to view GL Transaction Report" onclick="window.open('/GF/GFEmployeeProvision/GFEmployersProvisionsReport?id=@ViewBag.gfHeaderId')" id="" class="sym-btn-report btn-erp-print">&nbsp;Report(Summary)</button>
        </div>
        <div class="erp-breadcrumb">
            <label class="pull-right">GF Employee Provision &gt; Index</label>
        </div>
    </div>
    <div class="card erp-card">
        <div class="card-header erp-card-header">
            <p><i class="fa fa-calculator"></i> GF Employee Provision List</p>
        </div>
        <div class="card-body erp-card-body" style="padding: 16px 20px;">
            <table id="myDataTable" class="display">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>ProvisionAmount</th>
                        <th>IncrementArrear</th>
                        <th>TotalProvisionAmount</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script language="javascript" type="text/javascript">
    $(document).ready(function () {
        SelectAllForDelete();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/GF/GFEmployeeProvision/_index?gfHeaderId=@ViewBag.gfHeaderId",
            "bProcessing": true,
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "aoColumns": [
                             { "sName": "Code", "sWidth": "10%" }
                            , { "sName": "EmpName", "sWidth": "15%" }
                            , { "sName": "Designation", "sWidth": "15%" }
                            , { "sName": "Department", "sWidth": "10%" }
                            , { "sName": "ProvisionAmount", "sWidth": "10%" }
                            , { "sName": "IncrementArrear", "sWidth": "10%" }
                            , { "sName": "TotalProvisionAmount", "sWidth": "10%" }
            ]
        });
    });
</script>


@model SymViewModel.GF.GFEmployeeProvisionVM
@using UIHelper.MVC

<div class="erp-page-wrapper">
    <div class="erp-action-bar">
        <div class="erp-action-btns">
            <button type="button" title="Add New GF Process" data-url="/GF/GFEmployeeProvision/Process" onclick="GoTo(this)" id="" class="sym-btn-add btn-erp-add">&nbsp;New GF Process</button>
        </div>
        <div class="erp-breadcrumb">
            <label class="pull-right">Employee Provision &gt; Fiscal Period</label>
        </div>
    </div>
    <div class="card erp-card">
        <div class="card-header erp-card-header">
            <p><i class="fa fa-calculator"></i> Employee Provision List</p>
        </div>
        <div class="card-body erp-card-body" style="padding: 16px 20px;">
            <table id="myDataTable" class="display">
                <thead>
                    <tr>              
                        <th class="center">Action</th>
                        <th class="left">Code</th>
                        <th class="left">Project</th>
                        <th class="left">Fiscal Period</th>
                        <th class="left">Provision Amount</th>
                        <th class="left">Increment Arrear</th>
                        <th class="left">Total Provision Amount</th>
                        <th class="left">Post Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script language="javascript" type="text/javascript">
    $(function () {
        InitDateTimePickers();
        $.datepicker.regional[""].dateFormat = 'dd/M/y';
        $.datepicker.setDefaults($.datepicker.regional['']);
        var oTable = $('#myDataTable').dataTable({
            "bServerSide": true,
            "sAjaxSource": "/GF/GFEmployeeProvision/_indexFiscalPeriod?EmployeeId=@ViewBag.EmployeeId&fydid=@ViewBag.fydid",
            "bProcessing": true,    
            "aLengthMenu": tablelength(),
            "bJqueryUI": true,
            "bAutoWidth": false,
            "aoColumns": [
                            {
                                "sName": "Id",
                                "bSearchable": false,
                                "bSortable": false,
                                "sWidth": "08%",
                                "sClass": "center",
                                "fnRender": function (oObj) {
                                    return '  <a title="Click on for Details" style="text-decoration:none;"    href=\"/GF/GFEmployeeProvision/index?gfHeaderId=' + oObj.aData[0] + '\"  class="sym-btn-detail-row"></a>'
                                        + '&nbsp; <a title="Click on for Post" data-url="/GF/GFEmployeeProvision/Post"  onclick=btnPostNew(this);  data-Id="' + oObj.aData[0] + "~" + oObj.aData[7]  + '\" class="sym-btn-post-row"></a>'
                                    ;
                                }
                            }
                            , { "sName": "Code", "sWidth": "10%" }
                            , { "sName": "ProjectName", "sWidth": "15%" }
                            , { "sName": "FiscalPeriod", "sWidth": "10%" }
                            , { "sName": "ProvisionAmount", "sWidth": "10%" }
                            , { "sName": "IncrementArrear", "sWidth": "10%" }
                            , { "sName": "TotalProvisionAmount", "sWidth": "15%" }
                            , { "sName": "Post", "sWidth": "08%" }
            ]
        });
    });
</script>

<script>
    function btnPostNew(sender) {
        var Id = $(sender).attr("data-Id").split('~')[0];
        var post = $(sender).attr("data-Id").split('~')[1];
        if (post == "Posted") {
            ShowResult("Fail", "Data Already Posted!");
            return true;
        }
        var getURL = "/GF/GFEmployeeProvision/Post" + "?" + "ids=" + Id;

        $.getJSON(getURL, function (vm) {
            if (vm.Post) {
                ShowResult("Fail", "Data Already Posted!");
                return true;
            }
            else {
                var url = $(sender).attr("data-url") + "?ids=" + Id + '~';
                var questionMSG = "Are you sure to Post Data!";
                singleOperation(questionMSG, url);
            }
        });
    }
</script>

